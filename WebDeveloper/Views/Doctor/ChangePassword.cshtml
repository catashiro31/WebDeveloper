@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_DoctorLayout";
}

<style>
.input-eye-wrap {
    position: relative;
    display: flex;
    align-items: center;
    margin-top: 6px;
}
.input-eye-wrap input {
    width: 100%;
    padding: 12px 44px 12px 14px;
    border-radius: 10px;
    border: 1.5px solid #cbd5e1;
    box-sizing: border-box;
    font-family: var(--font-app);
    font-size: 14px;
    outline: none;
    transition: all 0.2s;
    background: #f8fafc;
}
.input-eye-wrap input:focus {
    background: #ffffff;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}
.toggle-eye-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
    border-radius: 6px;
}
.toggle-eye-btn:hover {
    color: #6366f1;
}
.pwd-strength-container {
    margin-top: 10px;
    margin-bottom: 6px;
}
.pwd-strength-bar-bg {
    height: 4px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 6px;
}
.pwd-strength-bar {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    transition: all 0.3s ease;
}
.pwd-strength-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    margin-bottom: 6px;
}
.pwd-rules-list {
    margin-top: 8px;
    padding: 10px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 12px;
    color: #64748b;
    display: flex;
    flex-direction: column;
    gap: 5px;
}
.pwd-rule-item {
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
}
.pwd-rule-item.valid {
    color: #16a34a;
    font-weight: 600;
}
.pwd-rule-icon {
    font-size: 13px;
    font-weight: 700;
}
.pwd-match-hint {
    font-size: 12px;
    font-weight: 600;
    margin-top: 6px;
    display: none;
}
</style>

<div class="reveal">
    <div style="max-width: 460px; margin: 0 auto; background: white; border-radius: 20px; padding: 36px; box-shadow: 0 4px 25px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #eef2ff; color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                🔐
            </div>
            <div>
                <h2 style="font-size: 22px; font-weight: 800; margin: 0; color: #0f172a;">Đổi mật khẩu</h2>
                <p style="margin: 2px 0 0; font-size: 13px; color: #64748b;">Bảo vệ tài khoản bằng mật khẩu an toàn</p>
            </div>
        </div>
        
        <div id="messageBox" style="display: none; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 13px; line-height: 1.5;"></div>

        <form id="changePasswordForm" onsubmit="handleSubmit(event)">
            <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 16px;">
                Mật khẩu hiện tại <span style="color: #ef4444;">*</span>
                <div class="input-eye-wrap">
                    <input type="password" id="oldPassword" required autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" />
                    <button type="button" class="toggle-eye-btn" onclick="togglePassword('oldPassword', this)" title="Hiện/ẩn mật khẩu">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </label>

            <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 16px;">
                Mật khẩu mới <span style="color: #ef4444;">*</span>
                <div class="input-eye-wrap">
                    <input type="password" id="newPassword" required autocomplete="new-password" placeholder="Nhập mật khẩu mới" oninput="checkPasswordStrength()" />
                    <button type="button" class="toggle-eye-btn" onclick="togglePassword('newPassword', this)" title="Hiện/ẩn mật khẩu">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <div class="pwd-strength-container" id="pwdStrengthBox">
                    <div class="pwd-strength-header">
                        <span style="color: #64748b;">Độ mạnh mật khẩu (tham khảo):</span>
                        <span id="pwdStrengthLabel" style="font-weight: 700; color: #94a3b8;">Chưa nhập</span>
                    </div>
                    <div class="pwd-strength-bar-bg">
                        <div id="pwdStrengthBar" class="pwd-strength-bar"></div>
                    </div>
                    <div class="pwd-rules-list">
                        <div class="pwd-rule-item" id="ruleLength">
                            <span class="pwd-rule-icon">○</span> Bắt buộc: Tối thiểu 6 ký tự
                        </div>
                        <div class="pwd-rule-item" id="ruleUpper">
                            <span class="pwd-rule-icon">○</span> Bắt buộc: Chứa ít nhất 1 chữ hoa (A-Z)
                        </div>
                        <div class="pwd-rule-item" id="ruleLower">
                            <span class="pwd-rule-icon">○</span> Bắt buộc: Chứa ít nhất 1 chữ thường (a-z)
                        </div>
                        <div class="pwd-rule-item" id="ruleNumber">
                            <span class="pwd-rule-icon">○</span> Bắt buộc: Chứa ít nhất 1 chữ số (0-9)
                        </div>
                    </div>
                </div>
            </label>

            <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 16px;">
                Xác nhận mật khẩu mới <span style="color: #ef4444;">*</span>
                <div class="input-eye-wrap">
                    <input type="password" id="confirmPassword" required autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" oninput="checkPasswordMatch()" />
                    <button type="button" class="toggle-eye-btn" onclick="togglePassword('confirmPassword', this)" title="Hiện/ẩn mật khẩu">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <div id="pwdMatchHint" class="pwd-match-hint"></div>
            </label>

            <button type="submit" id="submitBtn" style="margin-top: 24px; width: 100%; padding: 14px; border-radius: 12px; border: none; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.2s; font-family: var(--font-app); box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);" onmouseenter="if(!this.disabled){this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 18px rgba(99, 102, 241, 0.4)';}" onmouseleave="if(!this.disabled){this.style.transform='none'; this.style.boxShadow='0 4px 14px rgba(99, 102, 241, 0.3)';}">
                Cập nhật mật khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const eyeOpenSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
        const eyeCloseSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;

        window.togglePassword = function(id, btn) {
            const input = document.getElementById(id);
            if (!input) return;
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.innerHTML = isText ? eyeOpenSvg : eyeCloseSvg;
        };

        window.checkPasswordStrength = function() {
            const pwd = document.getElementById('newPassword').value;
            const bar = document.getElementById('pwdStrengthBar');
            const label = document.getElementById('pwdStrengthLabel');
            const ruleLength = document.getElementById('ruleLength');
            const ruleUpper = document.getElementById('ruleUpper');
            const ruleLower = document.getElementById('ruleLower');
            const ruleNumber = document.getElementById('ruleNumber');
            
            if (!pwd) {
                bar.style.width = '0%';
                bar.style.background = '#e2e8f0';
                label.textContent = 'Chưa nhập';
                label.style.color = '#94a3b8';
                updateRule(ruleLength, false);
                updateRule(ruleUpper, false);
                updateRule(ruleLower, false);
                updateRule(ruleNumber, false);
                return;
            }

            const hasLength = pwd.length >= 6;
            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasNumber = /\d/.test(pwd);

            updateRule(ruleLength, hasLength);
            updateRule(ruleUpper, hasUpper);
            updateRule(ruleLower, hasLower);
            updateRule(ruleNumber, hasNumber);

            let score = 0;
            if (hasLength) score += 1;
            if (hasUpper) score += 1;
            if (hasLower) score += 1;
            if (hasNumber) score += 1;
            if (pwd.length >= 10) score += 1;

            if (score <= 2) {
                bar.style.width = '33%';
                bar.style.background = '#ef4444';
                label.textContent = 'Yếu';
                label.style.color = '#ef4444';
            } else if (score <= 4) {
                bar.style.width = '66%';
                bar.style.background = '#f59e0b';
                label.textContent = 'Trung bình';
                label.style.color = '#f59e0b';
            } else {
                bar.style.width = '100%';
                bar.style.background = '#10b981';
                label.textContent = 'Mạnh';
                label.style.color = '#10b981';
            }

            checkPasswordMatch();
        };

        function updateRule(elem, isValid) {
            if (!elem) return;
            if (isValid) {
                elem.classList.add('valid');
                const icon = elem.querySelector('.pwd-rule-icon');
                if (icon) icon.textContent = '✓';
            } else {
                elem.classList.remove('valid');
                const icon = elem.querySelector('.pwd-rule-icon');
                if (icon) icon.textContent = '○';
            }
        }

        window.checkPasswordMatch = function() {
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const hint = document.getElementById('pwdMatchHint');

            if (!confirmPwd) {
                hint.style.display = 'none';
                return;
            }

            hint.style.display = 'block';
            if (newPwd === confirmPwd) {
                hint.textContent = '✓ Mật khẩu xác nhận trùng khớp';
                hint.style.color = '#16a34a';
            } else {
                hint.textContent = '✕ Mật khẩu xác nhận chưa khớp';
                hint.style.color = '#dc2626';
            }
        };

        function showMessage(text, type) {
            const box = document.getElementById('messageBox');
            box.style.display = 'block';
            box.innerText = text;
            if (type === 'success') {
                box.style.background = '#ecfdf5';
                box.style.color = '#059669';
                box.style.border = '1px solid #a7f3d0';
            } else {
                box.style.background = '#fef2f2';
                box.style.color = '#dc2626';
                box.style.border = '1px solid #fecaca';
            }
        }

        window.handleSubmit = function(e) {
            e.preventDefault();
            
            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (window.Validation) {
                const passCheck = window.Validation.validatePassword(newPassword);
                if (!passCheck.valid) {
                    showMessage(passCheck.message, "error");
                    return;
                }
            } else if (newPassword.length < 6) {
                showMessage("Mật khẩu phải có ít nhất 6 ký tự!", "error");
                return;
            }

            if (newPassword !== confirmPassword) {
                showMessage("Mật khẩu mới không khớp!", "error");
                return;
            }

            const currentAuthToken = localStorage.getItem('token');
            if (!currentAuthToken) {
                window.location.href = '/Auth/Login';
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = 'Đang cập nhật...';
            btn.style.opacity = '0.7';
            document.getElementById('messageBox').style.display = 'none';

            fetch('/api/v1/user/password', {
                method: 'PUT',
                headers: { 
                    'Authorization': `Bearer ${currentAuthToken}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ oldPassword, newPassword })
            })
            .then(async res => {
                if (res.ok) {
                    showMessage("Đổi mật khẩu thành công!", "success");
                    document.getElementById('oldPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';
                    checkPasswordStrength();
                    checkPasswordMatch();
                } else {
                    const msg = (typeof readApiMessage === 'function') ? await readApiMessage(res) : null;
                    showMessage(msg || "Mật khẩu cũ không chính xác hoặc có lỗi xảy ra", "error");
                }
            })
            .catch(() => showMessage("Đã xảy ra lỗi khi kết nối máy chủ", "error"))
            .finally(() => {
                btn.disabled = false;
                btn.innerText = 'Cập nhật mật khẩu';
                btn.style.opacity = '1';
            });
        };
    </script>
}
