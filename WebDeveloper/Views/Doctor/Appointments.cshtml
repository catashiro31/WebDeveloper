@{
    ViewData["Title"] = "Quản lý lịch hẹn";
    Layout = "_DoctorLayout";
}

<style>
.appointment-card {
    background: white; border-radius: 18px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border: 1px solid #f1f5f9; transition: all 0.3s ease; position: relative; overflow: hidden;
}
.appointment-card:hover { box-shadow: 0 10px 30px rgba(95,109,252,0.1); }
.filter-btn {
    padding: 8px 16px; border-radius: 10px; border: none; background: transparent; color: #64748b;
    cursor: pointer; font-size: 13px; font-weight: 700; transition: all 0.2s;
}
.filter-btn.active { background: white; color: #5f6dfc; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
.modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-content {
    background: white; border-radius: 32px; width: 100%; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    box-sizing: border-box; max-height: 90dvh; overflow-y: auto; transform: scale(0.95) translateY(20px); transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.modal-overlay.active .modal-content { transform: scale(1) translateY(0); }
.quick-reason-btn {
    padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc;
    color: #475569; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.quick-reason-btn:hover { background: #fee2e2; border-color: #fecaca; color: #dc2626; }
</style>

<div class="reveal">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; border-bottom: 1px solid #f1f5f9; padding-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: #0f172a;">Quản lý lịch hẹn</h2>
            <p style="margin: 4px 0 0; font-size: 14px; color: #64748b;">Theo dõi và xử lý các yêu cầu khám bệnh từ bệnh nhân</p>
        </div>
        <div style="display: flex; gap: 10px; background: #f8fafc; padding: 6px; border-radius: 14px; border: 1px solid #e2e8f0; overflow-x: auto;">
            <button class="filter-btn active" onclick="setFilter('ALL', this)">Tất cả</button>
            <button class="filter-btn" onclick="setFilter('PENDING', this)">Chờ duyệt</button>
            <button class="filter-btn" onclick="setFilter('CONFIRMED', this)">Sắp tới</button>
            <button class="filter-btn" onclick="setFilter('COMPLETED', this)">Đã khám</button>
        </div>
    </div>

    <div id="appointmentsContainer" style="display: flex; flex-direction: column; gap: 16px;">
        <div class="skeleton" style="height: 160px; width: 100%; border-radius: 18px;"></div>
        <div class="skeleton" style="height: 160px; width: 100%; border-radius: 18px;"></div>
    </div>
</div>

<!-- Result Modal -->
<div id="resultModal" class="modal-overlay" onclick="closeResultModal()">
    <div class="modal-content" style="max-width: 600px; padding: 40px;" onclick="event.stopPropagation()">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <h3 id="modalTitle" style="margin: 0; font-size: 22px; font-weight: 800; color: #0f172a;">Trả kết quả khám</h3>
                <p id="modalVisitInfo" style="color: #64748b; font-size: 14px;"></p>
                <p style="margin: 4px 0 0; color: #64748b; font-size: 14px;">Bệnh nhân: <span id="modalPatientName" style="color: #0f172a; font-weight: 700;"></span></p>
            </div>
            <button onclick="closeResultModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 20px; display: flex; align-items: center; justify-content: center;">×</button>
        </div>

        <form id="resultForm" onsubmit="submitResult(event)" style="display: flex; flex-direction: column; gap: 20px;">
            <input type="hidden" id="appointmentId" />
            <input type="hidden" id="resultMode" />
            
            <div style="background: #f8fafc; padding: 16px; border-radius: 16px; border: 1px solid #e2e8f0;">
                <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 13px; color: #334155; text-transform: uppercase; letter-spacing: 0.05em;">Chẩn đoán bệnh <span style="color: #ef4444;">*</span></label>
                <textarea id="diagnosis" placeholder="Bác sĩ nhập chẩn đoán cụ thể..." required style="width: 100%; padding: 14px; border-radius: 12px; border: 1.5px solid #cbd5e1; min-height: 100px; resize: vertical; box-sizing: border-box; font-size: 15px; color: #1e293b; outline: none; transition: border-color 0.2s; font-family: var(--font-app);" onfocus="this.style.borderColor='#5f6dfc'" onblur="this.style.borderColor='#cbd5e1'"></textarea>
            </div>

            <div>
                <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 13px; color: #64748b;">Tệp kết quả (JPG, PNG, PDF, DOC, DOCX — tối đa 5 MB)</label>
                <div style="position: relative; overflow: hidden;">
                    <input type="file" id="prescriptionFile" accept="image/jpeg,image/png,application/pdf,.doc,.docx" onchange="handleFileChange(event)" style="width: 100%; padding: 10px 14px; border-radius: 12px; border: 1.5px dashed #cbd5e1; background: #f8fafc; font-size: 13px; cursor: pointer; box-sizing: border-box;" />
                    <p id="fileStatus" style="margin: 8px 0 0; font-size: 12px; font-weight: 600; display: none;"></p>
                    <div id="existingFileLink" style="margin: 8px 0 0; display: none; align-items: center; gap: 8px;">
                        <p style="margin: 0; font-size: 12px; color: #3b82f6; font-weight: 600;">✓ Đã có file kết quả cũ</p>
                        <a id="fileUrlAnchor" href="#" target="_blank" rel="noopener noreferrer" style="font-size: 12px; color: #5f6dfc; text-decoration: underline; font-weight: 600;">Xem file</a>
                    </div>
                </div>
            </div>

            <div>
                <label for="prescriptionLink">Hoặc link kết quả (http/https)</label>
                <input id="prescriptionLink" type="url" placeholder="https://..." style="width:100%; padding:12px; box-sizing:border-box; border:1px solid #cbd5e1; border-radius:12px; margin-top:8px;" />
                <small>Chọn tệp hoặc nhập link mới. Để trống cả hai để giữ tệp/link đã lưu.</small>
            </div>
            <div>
                <label style="display: block; margin-bottom: 8px; font-weight: 700; font-size: 13px; color: #64748b;">Lời nhắn / Dặn dò bệnh nhân</label>
                <textarea id="doctorNotes" placeholder="Dặn dò uống thuốc, ngày tái khám..." style="width: 100%; padding: 14px; border-radius: 12px; border: 1.5px solid #e2e8f0; min-height: 80px; resize: vertical; box-sizing: border-box; font-size: 14px; color: #475569; outline: none; transition: border-color 0.2s; font-family: var(--font-app);" onfocus="this.style.borderColor='#5f6dfc'" onblur="this.style.borderColor='#e2e8f0'"></textarea>
            </div>

            <div>
                <label for="followUpDate">Hẹn ngày tái khám (không bắt buộc)</label>
                <input id="followUpDate" type="date" style="display:block; padding:12px; margin-top:8px; border:1px solid #cbd5e1; border-radius:12px;" />
                <small>Ngày bác sĩ đề nghị tái khám; bệnh nhân cần đặt lịch riêng.</small>
            </div>
            <div style="display: flex; gap: 12px; margin-top: 32px; border-top: 1px solid #f1f5f9; padding-top: 24px;">
                <button type="button" onclick="closeResultModal()" style="flex: 1; padding: 14px; border-radius: 14px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; cursor: pointer; font-weight: 700; font-size: 15px; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">Đóng</button>
                <button type="submit" id="submitResultBtn" style="flex: 2; padding: 14px; border-radius: 14px; border: none; background: linear-gradient(135deg, #5f6dfc, #3b82f6); color: white; cursor: pointer; font-weight: 700; font-size: 15px; box-shadow: 0 8px 20px rgba(95,109,252,0.3); transition: all 0.2s;">Lưu kết quả & Hoàn tất</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Từ chối lịch hẹn của Bác sĩ -->
<div id="doctorRejectModal" class="modal-overlay" onclick="closeDoctorRejectModal()">
    <div class="modal-content" style="max-width: 500px; padding: 32px;" onclick="event.stopPropagation()">
        <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
            <div style="width: 46px; height: 46px; border-radius: 14px; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">
                ✕
            </div>
            <div style="flex: 1;">
                <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Từ chối lịch hẹn khám</h3>
                <p style="margin: 4px 0 0; color: #64748b; font-size: 13px;">Vui lòng nêu lý do từ chối để hệ thống gửi thông báo giải thích cho bệnh nhân.</p>
            </div>
            <button type="button" onclick="closeDoctorRejectModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 18px; display: flex; align-items: center; justify-content: center;">✕</button>
        </div>

        <div id="doctorRejectAptInfo" style="background: #f8fafc; border-radius: 14px; padding: 12px 16px; margin-bottom: 18px; border: 1px solid #e2e8f0; font-size: 13px; color: #334155;">
            <div>Bệnh nhân: <b id="rejectModalPatientName" style="color: #0f172a;">—</b></div>
            <div style="margin-top: 4px; color: #64748b;">Thời gian khám: <span id="rejectModalTime" style="font-weight: 600; color: #475569;">—</span></div>
        </div>

        <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 11px; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">Chọn nhanh lý do</label>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <button type="button" class="quick-reason-btn" onclick="selectDoctorReason('Bác sĩ có lịch phẫu thuật / cấp cứu đột xuất')">Lịch mổ đột xuất</button>
                <button type="button" class="quick-reason-btn" onclick="selectDoctorReason('Bác sĩ bận lịch công tác ngoài bệnh viện')">Bận công tác</button>
                <button type="button" class="quick-reason-btn" onclick="selectDoctorReason('Trùng lịch hội chẩn chuyên môn')">Trùng hội chẩn</button>
                <button type="button" class="quick-reason-btn" onclick="selectDoctorReason('Bác sĩ nghỉ vì lý do sức khỏe')">Lý do sức khỏe</button>
                <button type="button" class="quick-reason-btn" onclick="selectDoctorReason('Triệu chứng phù hợp với chuyên khoa khác')">Sai chuyên khoa</button>
            </div>
        </div>

        <div style="margin-bottom: 24px;">
            <label for="doctorRejectReasonInput" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 8px;">
                Lý do từ chối cụ thể <span style="color: #ef4444;">*</span>
            </label>
            <textarea id="doctorRejectReasonInput" placeholder="Nhập lý do chi tiết từ chối lịch hẹn này..." rows="3" style="width: 100%; padding: 12px 14px; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 14px; color: #1e293b; outline: none; font-family: var(--font-app); box-sizing: border-box; resize: vertical; min-height: 85px; transition: border-color 0.2s;" onfocus="this.style.borderColor='#ef4444'" onblur="this.style.borderColor='#cbd5e1'"></textarea>
            <div id="doctorRejectError" style="display: none; color: #ef4444; font-size: 12px; font-weight: 600; margin-top: 6px;">Vui lòng nhập lý do từ chối.</div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" onclick="closeDoctorRejectModal()" style="padding: 11px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">
                Quay lại
            </button>
            <button type="button" id="confirmDoctorRejectBtn" onclick="confirmDoctorReject()" style="padding: 11px 24px; border-radius: 12px; border: none; background: #ef4444; color: white; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25); transition: all 0.2s;" onmouseenter="this.style.background='#dc2626'" onmouseleave="this.style.background='#ef4444'">
                Xác nhận từ chối
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        
        

        // Keep the fixed dialog outside the animated layout's transformed main element.
        document.body.appendChild(page.own(document.getElementById('resultModal')));
        const container = document.getElementById('appointmentsContainer');
        let allAppointments = [];
        let currentFilter = 'ALL';
        let currentFile = null;

        function formatSlotLabel(slot) {
            if (!slot || typeof slot !== "string") return slot;
            return slot.startsWith("SLOT_") ? slot.replace("SLOT_", "").replace(/_/g, ":") : slot;
        }

        function getStatusStyle(status) {
            const styles = {
                'PENDING': { bg: '#fef3c7', col: '#d97706' },
                'CONFIRMED': { bg: '#dbeafe', col: '#2563eb' },
                'COMPLETED': { bg: '#dcfce7', col: '#16a34a' },
                'CANCELLED': { bg: '#fee2e2', col: '#dc2626' },
                'NO_SHOW': { bg: '#f3f4f6', col: '#6b7280' }
            };
            return styles[status] || { bg: '#f3f4f6', col: '#6b7280' };
        }

        function getStatusText(status) {
            const texts = { 'PENDING': 'Chờ xác nhận', 'CONFIRMED': 'Đã xác nhận', 'COMPLETED': 'Đã khám', 'CANCELLED': 'Đã hủy', 'NO_SHOW': 'Không đến' };
            return texts[status] || status;
        }

        page.globals.setFilter = function(filter, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = filter;
            renderAppointments();
        };

        function fetchAppointments() {
            if (user && user.verificationStatus !== 'APPROVED') return;
            
            container.innerHTML = `
                <div class="skeleton" style="height: 160px; width: 100%; border-radius: 18px;"></div>
                <div class="skeleton" style="height: 160px; width: 100%; border-radius: 18px;"></div>
            `;
            
            fetch('/api/v1/doctor/appointment?page=0&size=200', { headers: { 'Authorization': `Bearer ${token}` } })
            .then(res => res.json())
            .then(data => {
                allAppointments = data.content || data || [];
                renderAppointments();
            })
            .catch(() => {
                container.innerHTML = `<div style="padding: 40px; text-align: center; background: #fef2f2; border-radius: 16px; color: #dc2626; font-weight: 600;">Không thể tải danh sách lịch hẹn</div>`;
            });
        }

        function renderAppointments() {
            const filtered = currentFilter === 'ALL' ? allAppointments : allAppointments.filter(a => a.bookingStatus === currentFilter);
            
            if (filtered.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 100px 20px; background: #f9fafb; border-radius: 24px; border: 2px dashed #e2e8f0;">
                        <div style="font-size: 48px; margin-bottom: 16px; opacity: 0.5;">📅</div>
                        <h3 style="margin: 0; font-size: 18px; color: #1e293b;">Không tìm thấy lịch hẹn</h3>
                        <p style="color: #64748b; margin-top: 8px;">Bạn hiện không có yêu cầu nào trong danh mục này.</p>
                    </div>
                `;
                return;
            }

            let html = '';
            filtered.forEach(apt => {
                const sStyle = getStatusStyle(apt.bookingStatus);
                let actionsHtml = '';
                const started = visitHasStarted(apt);
                if (apt.bookingStatus === 'PENDING') {
                    actionsHtml = `
                        <button onclick="updateStatus(${apt.appointmentId || apt.id}, 'CONFIRMED')" style="padding: 10px 16px; border-radius: 10px; border: none; background: linear-gradient(135deg, #10b981, #059669); color: white; cursor: pointer; font-weight: 700; font-size: 13px; box-shadow: 0 4px 12px rgba(16,185,129,0.2);">Xác nhận</button>
                        <button onclick="openDoctorRejectModal(${apt.appointmentId || apt.id})" style="padding: 10px 16px; border-radius: 10px; border: 1.5px solid #ef4444; background: white; color: #ef4444; cursor: pointer; font-weight: 700; font-size: 13px;">Từ chối</button>
                    `;
                } else if (apt.bookingStatus === 'CONFIRMED') {
                    actionsHtml = `
                        <button onclick="openResultModal(${apt.appointmentId || apt.id}, 'create')" style="padding: 10px 16px; border-radius: 10px; border: none; background: linear-gradient(135deg, #5f6dfc, #3b82f6); color: white; cursor: pointer; font-weight: 700; font-size: 13px; box-shadow: 0 4px 12px rgba(95,109,252,0.2);">Trả kết quả</button>
                        <button onclick="updateStatus(${apt.appointmentId || apt.id}, 'NO_SHOW')" style="padding: 10px 16px; border-radius: 10px; border: 1.5px solid #94a3b8; background: white; color: #64748b; cursor: pointer; font-weight: 700; font-size: 13px;">Không đến</button>
                    `;
                } else if (apt.bookingStatus === 'COMPLETED') {
                    actionsHtml = `
                        <button onclick="openResultModal(${apt.appointmentId || apt.id}, 'edit')" style="padding: 10px 16px; border-radius: 10px; border: 1.5px solid #5f6dfc; background: #f5f7ff; color: #5f6dfc; cursor: pointer; font-weight: 700; font-size: 13px;">Sửa kết quả</button>
                    `;
                }

                if (!started && (apt.bookingStatus === 'CONFIRMED' || apt.bookingStatus === 'COMPLETED'))
                    actionsHtml = '<button disabled title="Chưa đến giờ khám" style="padding:10px;border-radius:10px;opacity:.6;">Chưa đến giờ khám — chưa thể trả kết quả</button>';
                html += `
                    <div class="appointment-card">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #f0f4ff; color: #5f6dfc; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800;">
                                        ${(apt.patientName || 'P').charAt(0)}
                                    </div>
                                    <div>
                                        <h4 style="margin: 0; font-size: 17px; font-weight: 700; color: #1e293b;">${apt.patientName}</h4>
                                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
                                            <span style="padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; background: ${sStyle.bg}; color: ${sStyle.col};">${getStatusText(apt.bookingStatus)}</span>
                                        </div>
                                    </div>
                                </div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; color: #64748b; font-size: 13px; font-weight: 500;">
                                    <div style="display: flex; align-items: center; gap: 8px;"><span style="opacity: 0.7;">📅</span> ${apt.dateWorking}</div>
                                    <div style="display: flex; align-items: center; gap: 8px;"><span style="opacity: 0.7;">⏰</span> ${formatSlotLabel(apt.timeSlot || apt.startTime)}</div>
                                    ${apt.patientPhoneNumber ? `<div style="display: flex; align-items: center; gap: 8px;"><span style="opacity: 0.7;">📱</span> ${apt.patientPhoneNumber}</div>` : ''}
                                    ${apt.patientGender ? `<div style="display: flex; align-items: center; gap: 8px;"><span style="opacity: 0.7;">👤</span> ${apt.patientGender === 'MALE' ? 'Nam' : (apt.patientGender === 'FEMALE' ? 'Nữ' : 'Khác')}</div>` : ''}
                                </div>
                                ${apt.reason ? `
                                    <div style="margin-top: 16px; padding: 12px 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #edf2f7; font-size: 13px; color: #475569; line-height: 1.5;">
                                        <strong style="color: #64748b; font-size: 11px; text-transform: uppercase; display: block; margin-bottom: 4px; letter-spacing: 0.5px;">Lý do khám</strong>
                                        ${apt.reason}
                                    </div>
                                ` : ''}
                                ${apt.cancellationReason ? `
                                    <div style="margin-top: 12px; padding: 12px 16px; background: #fef2f2; border-radius: 12px; border: 1px solid #fee2e2; font-size: 13px; color: #991b1b; line-height: 1.5;">
                                        <strong style="color: #b91c1c; font-size: 11px; text-transform: uppercase; display: block; margin-bottom: 4px; letter-spacing: 0.5px;">Lý do ${apt.cancelledBy === 'PATIENT' ? 'bệnh nhân hủy' : 'từ chối'}</strong>
                                        ${apt.cancellationReason}
                                    </div>
                                ` : ''}
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 8px; min-width: 120px;">
                                ${actionsHtml}
                            </div>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        let currentRejectAptId = null;

        page.globals.openDoctorRejectModal = function(id) {
            currentRejectAptId = id;
            const apt = allAppointments.find(a => (a.appointmentId || a.id) == id);
            document.getElementById('rejectModalPatientName').innerText = apt ? apt.patientName : '—';
            document.getElementById('rejectModalTime').innerText = apt ? `${apt.dateWorking} (${formatSlotLabel(apt.timeSlot || apt.startTime)})` : '—';
            document.getElementById('doctorRejectReasonInput').value = '';
            document.getElementById('doctorRejectError').style.display = 'none';
            document.getElementById('confirmDoctorRejectBtn').disabled = false;
            document.getElementById('confirmDoctorRejectBtn').innerText = 'Xác nhận từ chối';
            document.getElementById('doctorRejectModal').classList.add('active');
        };

        page.globals.closeDoctorRejectModal = function() {
            document.getElementById('doctorRejectModal').classList.remove('active');
            currentRejectAptId = null;
        };

        page.globals.selectDoctorReason = function(txt) {
            const input = document.getElementById('doctorRejectReasonInput');
            input.value = txt;
            document.getElementById('doctorRejectError').style.display = 'none';
            input.focus();
        };

        page.globals.confirmDoctorReject = function() {
            if (!currentRejectAptId) return;
            const reason = document.getElementById('doctorRejectReasonInput').value.trim();
            if (!reason) {
                document.getElementById('doctorRejectError').style.display = 'block';
                return;
            }

            const btn = document.getElementById('confirmDoctorRejectBtn');
            btn.disabled = true;
            btn.innerText = 'Đang xử lý...';

            const url = `/api/v1/doctor/appointment/${currentRejectAptId}/status?status=CANCELLED&reason=${encodeURIComponent(reason)}`;
            fetch(url, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            })
            .then(async res => {
                if (res.ok) {
                    closeDoctorRejectModal();
                    showApiToast('Đã từ chối lịch hẹn', 'success');
                    fetchAppointments();
                } else {
                    showApiToast(await readApiMessage(res) || "Lỗi khi từ chối lịch hẹn", "error");
                    btn.disabled = false;
                    btn.innerText = 'Xác nhận từ chối';
                }
            })
            .catch(() => {
                showApiToast("Lỗi mạng", "error");
                btn.disabled = false;
                btn.innerText = 'Xác nhận từ chối';
            });
        };

        page.globals.updateStatus = function(id, status) {
            const msgs = { 'CONFIRMED': 'Xác nhận lịch hẹn này?', 'NO_SHOW': 'Đánh dấu bệnh nhân không đến?', 'COMPLETED': 'Đánh dấu đã hoàn thành khám?' };
            if (!confirm(msgs[status] || 'Xác nhận thay đổi?')) return;

            const url = `/api/v1/doctor/appointment/${id}/status?status=${status}`;
            fetch(url, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            })
            .then(async res => {
                if (res.ok) {
                    showApiToast('Cập nhật trạng thái thành công', 'success');
                    fetchAppointments();
                }
                else showApiToast(await readApiMessage(res) || "Lỗi", "error");
            })
            .catch(() => showApiToast("Lỗi mạng", "error"));
        };

        function visitHasStarted(apt) {
            const time = String(apt.timeSlot || apt.startTime || "").replace("SLOT_", "").replace("_", ":");
            const start = new Date(`${apt.dateWorking}T${time.length === 5 ? time + ":00" : time}+07:00`).getTime();
            return Number.isFinite(start) && start <= Date.now();
        }

        page.globals.openResultModal = function(id, mode) {
            const apt = allAppointments.find(a => (a.appointmentId || a.id) == id);
            if (!apt) return;
            if (!visitHasStarted(apt)) { showApiToast('Chưa đến giờ khám, chưa thể trả kết quả.', 'warning'); return; }

            document.getElementById('appointmentId').value = id;
            document.getElementById('resultMode').value = mode;
            document.getElementById('modalTitle').innerText = mode === 'edit' ? 'Cập nhật kết quả' : 'Trả kết quả khám';
            document.getElementById('submitResultBtn').innerText = mode === 'edit' ? 'Cập nhật kết quả' : 'Lưu kết quả & Hoàn tất';
            document.getElementById('modalPatientName').innerText = apt.patientName;
            document.getElementById('modalVisitInfo').textContent = `Mã ca khám: #${id} | Ngày khám: ${apt.dateWorking} ${apt.timeSlot || ''} | Khoa: ${apt.specialtyName || 'Chưa cập nhật'}`;
            document.getElementById('followUpDate').value = apt.followUpDate || '';
            // Ngày tái khám phải ít nhất là ngày mai
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowStr = tomorrow.toISOString().split('T')[0];
            document.getElementById('followUpDate').min = tomorrowStr;
            document.getElementById('prescriptionLink').value = '';
            
            document.getElementById('diagnosis').value = mode === 'edit' || apt.diagnosis ? (apt.diagnosis || '') : '';
            document.getElementById('doctorNotes').value = mode === 'edit' || apt.doctorNotes ? (apt.doctorNotes || '') : '';
            
            currentFile = null;
            document.getElementById('prescriptionFile').value = '';
            document.getElementById('fileStatus').style.display = 'none';

            const linkContainer = document.getElementById('existingFileLink');
            if (apt.prescriptionUrl) {
                linkContainer.style.display = 'flex';
                document.getElementById('fileUrlAnchor').href = apt.prescriptionUrl;
            } else {
                linkContainer.style.display = 'none';
            }

            document.getElementById('resultModal').classList.add('active');
        };

        page.globals.closeResultModal = () => document.getElementById('resultModal').classList.remove('active');

        page.globals.handleFileChange = function(e) {
            const f = e.target.files[0];
            const p = document.getElementById('fileStatus');
            if (f) {
                if (f.size > 5 * 1024 * 1024 || !['image/jpeg', 'image/png', 'application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'].includes(f.type)) {
                    e.target.value = '';
                    currentFile = null;
                    p.style.display = 'none';
                    showApiToast('Đơn thuốc phải là JPG, PNG, PDF, DOC hoặc DOCX và không quá 5 MB.', "error");
                    return;
                }
                currentFile = f;
                p.innerText = `✓ Đã chọn file mới: ${f.name}`;
                p.style.display = 'block';
                p.style.color = '#10b981';
            } else {
                currentFile = null;
                p.style.display = 'none';
            }
        };

        page.globals.submitResult = function(e) {
            e.preventDefault();
            const id = document.getElementById('appointmentId').value;
            const mode = document.getElementById('resultMode').value;
            const diagnosis = document.getElementById('diagnosis').value.trim();
            const notes = document.getElementById('doctorNotes').value.trim();

            if (!diagnosis) {
                showApiToast("Vui lòng nhập chẩn đoán", "warning");
                return;
            }

            const link = document.getElementById('prescriptionLink').value.trim();
            if (link && (currentFile || !/^https?:\/\//i.test(link))) {
                showApiToast('Chọn tệp hoặc nhập một link http/https hợp lệ.', 'error');
                return;
            }
            const btn = document.getElementById('submitResultBtn');
            if (btn.disabled) return;
            btn.disabled = true;
            btn.innerText = 'Đang lưu...';
            btn.style.background = '#cbd5e1';

            const formData = new FormData();
            formData.append('diagnosis', diagnosis);
            formData.append('doctorNotes', notes);
            formData.append('prescriptionLink', link);
            formData.append('followUpDate', document.getElementById('followUpDate').value);
            if (currentFile) formData.append('prescriptionFile', currentFile);

            const url = mode === 'edit' ? `/api/v1/doctor/appointment/${id}/result` : `/api/v1/doctor/appointment/${id}/result`;
            const method = mode === 'edit' ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            })
            .then(async res => {
                if (res.ok) {
                    closeResultModal();
                    fetchAppointments();
                    showApiToast("Lưu kết quả thành công", "success");
                } else {
                    const msg = await readApiMessage(res);
                    showApiToast(msg || "Không thể lưu kết quả", "error");
                }
            })
            .catch(() => showApiToast("Lỗi mạng", "error"))
            .finally(() => {
                btn.disabled = false;
                btn.innerText = mode === 'edit' ? 'Cập nhật kết quả' : 'Lưu kết quả & Hoàn tất';
                btn.style.background = 'linear-gradient(135deg, #5f6dfc, #3b82f6)';
            });
        };

        fetchAppointments();

    page.expose({formatSlotLabel, getStatusStyle, getStatusText, fetchAppointments, renderAppointments, visitHasStarted});
});
</script>
}

