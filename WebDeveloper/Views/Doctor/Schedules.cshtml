@{
    ViewData["Title"] = "Lịch làm việc";
    Layout = "_DoctorLayout";
}

<style>
.modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(8px);
    display: flex; align-items: flex-start; justify-content: center; z-index: 1000; padding: 24px 20px;
    overflow-y: auto;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-content {
    background: white; border-radius: 24px; width: 100%; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    max-height: calc(100vh - 48px); overflow-y: auto; transform: scale(0.96) translateY(-15px); transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    margin-top: 8px;
}
.modal-overlay.active .modal-content { transform: scale(1) translateY(0); }

/* Chips cho từng ngày */
.date-chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 12px;
    border: 1.5px solid #e2e8f0; background: #f8fafc; color: #334155; font-size: 13px; font-weight: 500;
    cursor: pointer; transition: all 0.2s ease; user-select: none;
}
.date-chip:hover { border-color: #cbd5e1; background: #f1f5f9; }
.date-chip.active {
    border-color: #5f6dfc; background: #eef2ff; color: #4f46e5; font-weight: 600;
    box-shadow: 0 2px 8px rgba(95, 109, 252, 0.15);
}
.date-chip-badge {
    background: #e2e8f0; color: #475569; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600;
}
.date-chip.active .date-chip-badge {
    background: #c7d2fe; color: #3730a3;
}
.date-chip-remove {
    background: transparent; border: none; color: #94a3b8; font-size: 14px; cursor: pointer;
    padding: 0 2px; line-height: 1; border-radius: 4px; transition: all 0.15s;
}
.date-chip-remove:hover { color: #ef4444; background: #fee2e2; }

/* Chip khung giờ */
.slot-chip {
    display: flex; align-items: center; justify-content: space-between; padding: 10px 14px;
    border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #334155;
    font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; user-select: none;
}
.slot-chip:hover { border-color: #cbd5e1; background: #f8fafc; }
.slot-chip.selected {
    border-color: #5f6dfc; background: #eef2ff; color: #4f46e5; font-weight: 600;
    box-shadow: 0 2px 8px rgba(95, 109, 252, 0.12);
}
.quick-date-btn {
    padding: 5px 10px; font-size: 12px; font-weight: 600; border-radius: 8px; border: 1px solid #cbd5e1;
    background: white; color: #475569; cursor: pointer; transition: all 0.2s;
}
.quick-date-btn:hover { background: #f1f5f9; color: #5f6dfc; border-color: #5f6dfc; }
</style>

<div class="reveal">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: #0f172a;">Lịch làm việc</h2>
            <p style="margin: 4px 0 0; font-size: 14px; color: #64748b;">Quản lý các ca khám bệnh trong ngày</p>
        </div>
        <button onclick="openModal()" style="padding: 10px 20px; border-radius: 12px; border: none; background: #5f6dfc; color: white; cursor: pointer; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(95,109,252,0.2); transition: all 0.2s;" onmouseenter="this.style.background='#4f46e5'" onmouseleave="this.style.background='#5f6dfc'">
            + Thêm lịch làm việc
        </button>
    </div>

    <div id="schedulesContainer" style="display: flex; flex-direction: column; gap: 16px;">
        <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
    </div>
</div>

<!-- Modal Tạo lịch làm việc -->
<div id="scheduleModal" class="modal-overlay" onclick="closeModal()">
    <div class="modal-content" style="max-width: 680px; padding: 32px;" onclick="event.stopPropagation()">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <div>
                <h3 style="margin: 0; font-size: 20px; font-weight: 700; color: #0f172a;">Tạo lịch làm việc</h3>
                <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">Chọn ngày và click vào từng ngày để tùy chỉnh các khung giờ khám</p>
            </div>
            <button onclick="closeModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 20px; display: flex; align-items: center; justify-content: center;">×</button>
        </div>

        <!-- Bước 1: Chọn ngày -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <label style="font-weight: 700; font-size: 14px; color: #1e293b;">1. Danh sách ngày khám đã chọn</label>
                <div style="display: flex; gap: 6px;">
                    <button type="button" class="quick-date-btn" onclick="quickAddDate(0)">+ Hôm nay</button>
                    <button type="button" class="quick-date-btn" onclick="quickAddDate(1)">+ Ngày mai</button>
                    <button type="button" class="quick-date-btn" onclick="quickAddWeek()">+ 7 ngày tới</button>
                </div>
            </div>

            <!-- Thêm ngày -->
            <div style="display: flex; gap: 8px; margin-bottom: 14px;">
                <input type="date" id="datePickerInput" style="flex: 1; padding: 10px 14px; border-radius: 10px; border: 1px solid #cbd5e1; font-family: var(--font-app); font-size: 14px; outline: none;" onfocus="this.style.borderColor='#5f6dfc'" onblur="this.style.borderColor='#cbd5e1'" />
                <button type="button" onclick="addPickerDate()" style="padding: 10px 18px; background: #5f6dfc; color: white; border: none; border-radius: 10px; font-weight: 600; font-size: 13px; cursor: pointer; white-space: nowrap; transition: background 0.2s;" onmouseenter="this.style.background='#4f46e5'" onmouseleave="this.style.background='#5f6dfc'">
                    + Thêm ngày
                </button>
            </div>

            <!-- Container chứa chips ngày -->
            <div id="selectedDatesList" style="display: flex; flex-wrap: wrap; gap: 8px; min-height: 42px; align-items: center;">
            </div>
            <small style="display: block; margin-top: 8px; color: #64748b; font-size: 12px;">💡 Nhấp vào ngày bất kỳ ở trên để xem và chọn khung giờ riêng cho ngày đó.</small>
        </div>

        <!-- Bước 2: Cấu hình khung giờ cho ngày đang active -->
        <div style="border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
                <div>
                    <span style="font-size: 14px; font-weight: 700; color: #1e293b;">2. Khung giờ cho:</span>
                    <span id="activeDateDisplay" style="font-weight: 700; color: #5f6dfc; font-size: 14px; margin-left: 6px;">Chưa chọn</span>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button type="button" onclick="toggleAllSlotsForActiveDate(true)" style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 500; cursor: pointer; color: #374151;">Chọn cả 7 ca</button>
                    <button type="button" onclick="toggleAllSlotsForActiveDate(false)" style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 500; cursor: pointer; color: #ef4444;">Bỏ chọn hết</button>
                </div>
            </div>

            <div id="slotsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(135px, 1fr)); gap: 10px;">
            </div>
        </div>

        <!-- Tóm tắt -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; margin-bottom: 20px; flex-wrap: wrap; gap: 8px;">
            <span id="summaryText" style="font-size: 13px; color: #166534; font-weight: 600;">📊 Đã chọn: 0 ngày, 0 ca khám</span>
            <span style="font-size: 12px; color: #15803d;">Các ca đã có bệnh nhân đặt sẽ được giữ nguyên</span>
        </div>

        <div style="display: flex; gap: 12px;">
            <button type="button" onclick="closeModal()" style="flex: 1; padding: 12px; border-radius: 12px; border: 1px solid #cbd5e1; background: white; cursor: pointer; font-weight: 600; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">Hủy</button>
            <button type="button" id="submitBtn" onclick="createSchedules()" style="flex: 1; padding: 12px; border-radius: 12px; border: none; background: #5f6dfc; color: white; cursor: pointer; font-weight: 600; transition: all 0.2s; box-shadow: 0 4px 12px rgba(95,109,252,0.2);" onmouseenter="this.style.background='#4f46e5'" onmouseleave="this.style.background='#5f6dfc'">Lưu & Tạo lịch</button>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa lịch làm việc -->
<div id="deleteScheduleModal" class="modal-overlay" onclick="closeDeleteScheduleModal()" style="align-items: center;">
    <div class="modal-content" style="max-width: 440px; padding: 32px;" onclick="event.stopPropagation()">
        <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
            <div style="width: 48px; height: 48px; border-radius: 14px; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">
                🗑️
            </div>
            <div style="flex: 1;">
                <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Xóa lịch làm việc</h3>
                <p style="margin: 4px 0 0; color: #64748b; font-size: 13px;">Gỡ bỏ khung giờ khám đã tạo</p>
            </div>
            <button type="button" onclick="closeDeleteScheduleModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 18px; display: flex; align-items: center; justify-content: center;">✕</button>
        </div>

        <div style="background: #f8fafc; border-radius: 16px; padding: 16px; margin-bottom: 20px; border: 1px solid #e2e8f0; font-size: 14px; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between;"><span style="color: #64748b;">Ngày khám:</span> <b id="delSchedDate" style="color: #0f172a;">—</b></div>
            <div style="display: flex; justify-content: space-between; align-items: center;"><span style="color: #64748b;">Khung giờ:</span> <span id="delSchedTime" style="font-weight: 700; color: #16a34a; background: #dcfce7; padding: 3px 12px; border-radius: 8px;">—</span></div>
        </div>

        <p style="font-size: 14px; color: #475569; line-height: 1.5; margin: 0 0 24px;">
            Bạn có chắc chắn muốn xóa khung giờ làm việc này không? Bệnh nhân sẽ không thể đặt lịch khám vào khung giờ này nữa.
        </p>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" onclick="closeDeleteScheduleModal()" style="padding: 11px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">
                Quay lại
            </button>
            <button type="button" id="confirmDeleteSchedBtn" onclick="confirmDeleteSchedule()" style="padding: 11px 24px; border-radius: 12px; border: none; background: #ef4444; color: white; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25); transition: all 0.2s;" onmouseenter="this.style.background='#dc2626'" onmouseleave="this.style.background='#ef4444'">
                Xác nhận xóa
            </button>
        </div>
    </div>
</div>

<p style="padding:12px; color:#475569;">🔴 Đã có bệnh nhân đặt &nbsp; 🟢 Còn trống (Có thể xóa)</p>

@section Scripts {
    <script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        document.body.appendChild(page.own(document.getElementById('deleteScheduleModal')));
        const TIME_SLOTS = ['SLOT_09_00', 'SLOT_10_00', 'SLOT_11_00', 'SLOT_14_00', 'SLOT_15_00', 'SLOT_16_00', 'SLOT_17_00'];
        let selectedDatesMap = {};
        let activeDate = null;
        let schedulesRawList = [];
        let targetDeleteScheduleId = null;

        function formatTimeSlot(slot) {
            return slot.replace('SLOT_', '').replace('_', ':');
        }

        function addDays(dateStr, days) {
            const value = new Date(dateStr + 'T00:00:00Z');
            value.setUTCDate(value.getUTCDate() + days);
            return value.toISOString().slice(0, 10);
        }

        function getTodayStr() {
            return new Intl.DateTimeFormat('en-CA', { timeZone:'Asia/Ho_Chi_Minh', year:'numeric', month:'2-digit', day:'2-digit' }).format(new Date());
        }

        function formatDateVi(dateStr) {
            if (!dateStr) return '';
            const [y, m, d] = dateStr.split('-');
            const dateObj = new Date(dateStr + 'T00:00:00');
            const dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
            return `${dayNames[dateObj.getDay()]}, ${d}/${m}`;
        }

        function formatDateFullVi(dateStr) {
            if (!dateStr) return '';
            const [y, m, d] = dateStr.split('-');
            const dateObj = new Date(dateStr + 'T00:00:00');
            const dayNames = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            return `${dayNames[dateObj.getDay()]}, ${d}/${m}/${y}`;
        }

        function renderDatesList() {
            const container = document.getElementById('selectedDatesList');
            const dates = Object.keys(selectedDatesMap).sort();

            if (dates.length === 0) {
                container.innerHTML = `<span style="color: #94a3b8; font-size: 13px; font-style: italic;">Chưa chọn ngày nào. Vui lòng thêm ngày ở trên.</span>`;
                document.getElementById('activeDateDisplay').textContent = 'Chưa chọn ngày';
                renderSlotsGrid();
                renderSummary();
                return;
            }

            if (!activeDate || !selectedDatesMap[activeDate]) {
                activeDate = dates[0];
            }

            document.getElementById('activeDateDisplay').textContent = formatDateFullVi(activeDate);

            container.innerHTML = dates.map(date => {
                const slotsCount = (selectedDatesMap[date] || []).length;
                const isActive = date === activeDate;
                return `
                    <div class="date-chip ${isActive ? 'active' : ''}" onclick="selectActiveDate('${date}')">
                        <span>📅 ${formatDateVi(date)}</span>
                        <span class="date-chip-badge">${slotsCount} ca</span>
                        <button type="button" class="date-chip-remove" onclick="removeDate(event, '${date}')" title="Xóa ngày này">✕</button>
                    </div>
                `;
            }).join('');

            renderSlotsGrid();
            renderSummary();
        }

        function selectActiveDate(date) {
            activeDate = date;
            renderDatesList();
        }

        function removeDate(event, date) {
            event.stopPropagation();
            delete selectedDatesMap[date];
            if (activeDate === date) {
                const remaining = Object.keys(selectedDatesMap).sort();
                activeDate = remaining.length > 0 ? remaining[0] : null;
            }
            renderDatesList();
        }

        function addDate(dateStr) {
            if (!dateStr) return;
            const today = getTodayStr();
            if (dateStr < today) {
                showApiToast("Không thể chọn ngày trong quá khứ", "warning");
                return;
            }
            const maxDate = addDays(today, 30);
            if (dateStr > maxDate) {
                showApiToast("Chỉ có thể chọn lịch trong vòng 30 ngày tới", "warning");
                return;
            }

            if (!selectedDatesMap[dateStr]) {
                selectedDatesMap[dateStr] = [...TIME_SLOTS];
            }
            activeDate = dateStr;
            renderDatesList();
        }

        function addPickerDate() {
            const picker = document.getElementById('datePickerInput');
            if (!picker.value) {
                showApiToast("Vui lòng chọn ngày", "warning");
                return;
            }
            addDate(picker.value);
        }

        function quickAddDate(offsetDays) {
            const today = getTodayStr();
            addDate(addDays(today, offsetDays));
        }

        function quickAddWeek() {
            const today = getTodayStr();
            for (let i = 0; i < 7; i++) {
                const d = addDays(today, i);
                if (!selectedDatesMap[d]) {
                    selectedDatesMap[d] = [...TIME_SLOTS];
                }
            }
            if (!activeDate || !selectedDatesMap[activeDate]) {
                activeDate = today;
            }
            renderDatesList();
        }

        function renderSlotsGrid() {
            const grid = document.getElementById('slotsGrid');
            if (!activeDate || !selectedDatesMap[activeDate]) {
                grid.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: #94a3b8; padding: 20px;">Vui lòng thêm hoặc chọn 1 ngày ở trên để cấu hình khung giờ</div>`;
                return;
            }

            const currentSlots = selectedDatesMap[activeDate] || [];
            grid.innerHTML = TIME_SLOTS.map(slot => {
                const isSelected = currentSlots.includes(slot);
                return `
                    <div class="slot-chip ${isSelected ? 'selected' : ''}" onclick="toggleSlot('${slot}')">
                        <span>${formatTimeSlot(slot)}</span>
                        <span>${isSelected ? '✓' : '+'}</span>
                    </div>
                `;
            }).join('');
        }

        function toggleSlot(slot) {
            if (!activeDate) return;
            if (!selectedDatesMap[activeDate]) selectedDatesMap[activeDate] = [];
            
            const index = selectedDatesMap[activeDate].indexOf(slot);
            if (index > -1) {
                selectedDatesMap[activeDate].splice(index, 1);
            } else {
                selectedDatesMap[activeDate].push(slot);
            }
            renderDatesList();
        }

        function toggleAllSlotsForActiveDate(select) {
            if (!activeDate) return;
            selectedDatesMap[activeDate] = select ? [...TIME_SLOTS] : [];
            renderDatesList();
        }

        function renderSummary() {
            const dates = Object.keys(selectedDatesMap);
            let totalSlots = 0;
            let validDays = 0;
            dates.forEach(d => {
                const count = (selectedDatesMap[d] || []).length;
                if (count > 0) {
                    validDays++;
                    totalSlots += count;
                }
            });
            document.getElementById('summaryText').textContent = `📊 Đã chọn: ${validDays} ngày, ${totalSlots} ca khám`;
        }

        page.globals.openModal = function() {
            const today = getTodayStr();
            const dateInput = document.getElementById('datePickerInput');
            dateInput.min = today;
            dateInput.max = addDays(today, 30);
            dateInput.value = today;

            // Khởi tạo mặc định nếu rỗng: thêm ngày hôm nay với 7 ca
            if (Object.keys(selectedDatesMap).length === 0) {
                selectedDatesMap[today] = [...TIME_SLOTS];
                activeDate = today;
            }
            renderDatesList();
            const modalEl = document.getElementById('scheduleModal');
            modalEl.scrollTop = 0;
            modalEl.classList.add('active');
        };

        page.globals.closeModal = () => document.getElementById('scheduleModal').classList.remove('active');

        function fetchSchedules() {
            if (user && user.verificationStatus !== 'APPROVED') return;
            const container = document.getElementById('schedulesContainer');
            fetch('/api/v1/doctor/schedules', { headers: { 'Authorization': `Bearer ${token}` } })
            .then(res => res.json())
            .then(data => {
                schedulesRawList = Array.isArray(data) ? data : [];
                
                const grouped = schedulesRawList.filter(s => s.slotStatus !== 'CLOSED').reduce((acc, sch) => {
                    if (!acc[sch.dateWorking]) acc[sch.dateWorking] = [];
                    acc[sch.dateWorking].push(sch);
                    return acc;
                }, {});

                if (Object.keys(grouped).length === 0) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 60px; color: #6b7280; background: white; border-radius: 16px; border: 1px dashed #cbd5e1;">
                            <p style="font-size: 18px; margin-bottom: 10px;">Chưa có lịch làm việc nào</p>
                            <p style="font-size: 14px;">Tạo lịch làm việc để bệnh nhân có thể đặt khám</p>
                        </div>
                    `;
                    return;
                }

                let html = '';
                Object.keys(grouped).sort().forEach(date => {
                    const d = new Date(date);
                    const dateStr = d.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                    
                    let slotsHtml = grouped[date].sort((a,b) => a.timeSlot.localeCompare(b.timeSlot)).map(slot => `
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 8px; background: ${slot.slotStatus === 'BOOKED' ? '#fee2e2' : '#dcfce7'}; border: 1px solid ${slot.slotStatus === 'BOOKED' ? '#fecaca' : '#bbf7d0'};">
                            <span style="font-weight: 500; color: ${slot.slotStatus === 'BOOKED' ? '#dc2626' : '#16a34a'}">${formatTimeSlot(slot.timeSlot)}</span>
                            ${slot.slotStatus === 'BOOKED' 
                                ? `<span style="font-size: 12px; color: #dc2626;">Đã đặt</span>` 
                                : `<button onclick="openDeleteScheduleModal(${slot.scheduleId})" style="background: none; border: none; color: #6b7280; cursor: pointer; padding: 2px; font-size: 14px;" title="Xóa">✕</button>`}
                        </div>
                    `).join('');

                    html += `
                        <div style="background: white; border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid #f1f5f9;">
                            <div style="font-weight: 600; font-size: 16px; margin-bottom: 16px; color: #0f172a;">📅 ${dateStr}</div>
                            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                ${slotsHtml}
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
            })
            .catch(() => {
                container.innerHTML = `<div style="color: #dc2626; text-align: center; padding: 40px; background: #fef2f2; border-radius: 16px;">Không thể tải lịch làm việc</div>`;
            });
        }

        page.globals.createSchedules = function() {
            const items = Object.keys(selectedDatesMap)
                .filter(d => selectedDatesMap[d] && selectedDatesMap[d].length > 0)
                .map(d => ({ date: d, slotIds: selectedDatesMap[d] }));

            if (items.length === 0) {
                showApiToast("Vui lòng chọn ít nhất 1 ngày và 1 khung giờ làm việc", "warning");
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true; btn.innerText = 'Đang lưu...'; btn.style.background = '#cbd5e1';

            fetch('/api/v1/doctor/schedules', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: items })
            })
            .then(async res => {
                if (res.ok) {
                    closeModal();
                    fetchSchedules();
                    showApiToast(await readApiMessage(res) || "Tạo lịch thành công", "success");
                } else {
                    const msg = await readApiMessage(res);
                    showApiToast(msg || "Không thể tạo lịch làm việc", "error");
                }
            })
            .catch(() => showApiToast("Lỗi mạng", "error"))
            .finally(() => {
                btn.disabled = false; btn.innerText = 'Lưu & Tạo lịch'; btn.style.background = '#5f6dfc';
            });
        };

        page.globals.openDeleteScheduleModal = function(id) {
            targetDeleteScheduleId = id;
            const sch = schedulesRawList.find(s => (s.scheduleId || s.id) == id);
            if (sch) {
                const d = new Date(sch.dateWorking);
                const dateStr = d.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                document.getElementById('delSchedDate').innerText = dateStr;
                document.getElementById('delSchedTime').innerText = formatTimeSlot(sch.timeSlot);
            } else {
                document.getElementById('delSchedDate').innerText = '—';
                document.getElementById('delSchedTime').innerText = '—';
            }
            const btn = document.getElementById('confirmDeleteSchedBtn');
            btn.disabled = false;
            btn.innerText = 'Xác nhận xóa';
            document.getElementById('deleteScheduleModal').classList.add('active');
        };

        page.globals.closeDeleteScheduleModal = function() {
            document.getElementById('deleteScheduleModal').classList.remove('active');
            targetDeleteScheduleId = null;
        };

        page.globals.confirmDeleteSchedule = function() {
            if (!targetDeleteScheduleId) return;
            const btn = document.getElementById('confirmDeleteSchedBtn');
            btn.disabled = true;
            btn.innerText = 'Đang xóa...';

            fetch(`/api/v1/doctor/schedules/${targetDeleteScheduleId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
            })
            .then(async res => {
                if (res.ok) {
                    page.globals.closeDeleteScheduleModal();
                    showApiToast('Đã xóa khung giờ làm việc', 'success');
                    fetchSchedules();
                } else {
                    showApiToast(await readApiMessage(res) || "Không thể xóa lịch (có thể đã có người đặt)", "error");
                    btn.disabled = false;
                    btn.innerText = 'Xác nhận xóa';
                }
            })
            .catch(() => {
                showApiToast("Lỗi mạng", "error");
                btn.disabled = false;
                btn.innerText = 'Xác nhận xóa';
            });
        };

        page.globals.deleteSchedule = page.globals.openDeleteScheduleModal;

        fetchSchedules();
        setInterval(() => { if (!document.hidden && !document.getElementById("scheduleModal").classList.contains("active")) fetchSchedules(); }, 60000);

    page.expose({formatTimeSlot, addDays, getTodayStr, formatDateVi, formatDateFullVi, renderDatesList, selectActiveDate, removeDate, addDate, addPickerDate, quickAddDate, quickAddWeek, renderSlotsGrid, toggleSlot, toggleAllSlotsForActiveDate, renderSummary, fetchSchedules, openDeleteScheduleModal: page.globals.openDeleteScheduleModal, closeDeleteScheduleModal: page.globals.closeDeleteScheduleModal, confirmDeleteSchedule: page.globals.confirmDeleteSchedule});
});
</script>
}

