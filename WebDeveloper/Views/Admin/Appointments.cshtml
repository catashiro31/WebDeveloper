@{
    ViewData["Title"] = "Quản lý lịch hẹn";
    Layout = "_AdminLayout";
}

<style>
.admin-card {
    background: #fff;
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
}
.header-area {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
}
.page-title {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    color: #1e293b;
}
.page-desc {
    margin: 8px 0 0;
    font-size: 15px;
    color: #64748b;
}
.filter-tabs {
    display: flex;
    background: #f1f5f9;
    padding: 6px;
    border-radius: 14px;
    gap: 4px;
    overflow-x: auto;
}
.filter-tab {
    padding: 10px 18px;
    border: none;
    background: transparent;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}
.filter-tab.active {
    background: #fff;
    color: #6366f1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.premium-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}
.premium-table th {
    padding: 16px 24px;
    background: #f8fafc;
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid #f1f5f9;
}
.premium-table td {
    padding: 20px 24px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
    vertical-align: middle;
}
.premium-table tr:hover {
    background: #fafbfc;
}
.status-pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid;
}
.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
.pagination button {
    padding: 8px 16px; border: 1px solid #e2e8f0; background: #fff;
    border-radius: 8px; cursor: pointer; font-weight: 600; color: #475569; font-size: 14px;
    transition: all 0.2s;
}
.pagination button:hover:not(:disabled) { border-color: #6366f1; color: #6366f1; }
.pagination button.active { background: #6366f1; color: #fff; border-color: #6366f1; font-weight: 700; }
.pagination button:disabled { opacity: 0.45; cursor: not-allowed; }

.patient-name-link {
    font-weight: 700; color: #1e293b; text-decoration: none; cursor: pointer; transition: color 0.2s;
    border-bottom: 1px dashed #cbd5e1;
}
.patient-name-link:hover { color: #6366f1; border-color: #6366f1; }
.patient-id-badge {
    background: #eef2ff; color: #4f46e5; font-size: 11px; font-weight: 800; padding: 2px 7px; border-radius: 6px; border: 1px solid #e0e7ff;
}

.filter-card {
    background: white; border-radius: 16px; padding: 14px 20px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    border: 1px solid #e2e8f0; margin-bottom: 24px;
}
.filter-select {
    padding: 8px 12px; border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: 13px;
    font-weight: 600; color: #1e293b; background: white; outline: none; cursor: pointer; transition: all 0.2s; font-family: var(--font-app);
}
.filter-select:focus { border-color: #6366f1; }
.filter-btn-reset {
    padding: 8px 16px; border-radius: 10px; border: 1.5px solid #e2e8f0; background: #f8fafc;
    color: #64748b; font-weight: 700; font-size: 13px; cursor: pointer; transition: all 0.2s; white-space: nowrap;
}
.filter-btn-reset:hover { background: #f1f5f9; color: #1e293b; }

.modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.3s;
    padding: 24px 16px; box-sizing: border-box; overflow-y: auto;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-content {
    background: white; border-radius: 24px; padding: 24px 28px; width: 100%; max-width: 580px;
    max-height: calc(100vh - 48px); overflow-y: auto; box-sizing: border-box;
    transform: scale(0.95); transition: transform 0.3s; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
}
.modal-overlay.active .modal-content { transform: scale(1); }

@@media (max-width: 768px) {
    .header-area {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 16px !important;
    }
    .filter-tabs {
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .admin-card {
        padding: 16px !important;
        border-radius: 18px !important;
    }
    .filter-item-wrap {
        flex: 1 1 100% !important;
        min-width: 100% !important;
    }
    .filter-item-wrap select, .filter-item-wrap input {
        width: 100% !important;
    }
    .filter-btn-reset-wrap {
        width: 100% !important;
        margin-left: 0 !important;
    }
    .filter-btn-reset-wrap button {
        width: 100% !important;
        min-height: 44px !important;
    }
    #appointmentDetailModal .modal-content {
        padding: 20px 16px !important;
        border-radius: 20px !important;
    }
    #appointmentDetailModal .modal-content > div:nth-child(2) > div,
    #appointmentDetailModal .modal-content > div:nth-child(3) > div {
        grid-template-columns: 1fr !important;
        gap: 8px !important;
    }
}
</style>

<div class="header-area">
    <div>
        <h2 class="page-title">Lịch hẹn hệ thống</h2>
        <p class="page-desc">Quản lý và giám sát tất cả các lượt đăng ký khám bệnh toàn sàn</p>
    </div>
    
    <div class="filter-tabs" id="statusFilters">
        <button class="filter-tab active" data-status="">Tất cả</button>
        <button class="filter-tab" data-status="PENDING">Chờ duyệt</button>
        <button class="filter-tab" data-status="CONFIRMED">Xác nhận</button>
        <button class="filter-tab" data-status="COMPLETED">Hoàn thành</button>
        <button class="filter-tab" data-status="CANCELLED">Đã hủy</button>
        <button class="filter-tab" data-status="NO_SHOW">Vắng mặt</button>
    </div>
</div>

<!-- Thanh lọc nằm ngang gọn gàng -->
<div class="filter-card">
    <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; width: 100%;">
        <div class="filter-item-wrap" style="display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 160px;">
            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">🏥 Chuyên khoa</label>
            <select id="filterSpecialty" class="filter-select" style="min-width: 160px;">
                <option value="">Tất cả chuyên khoa</option>
            </select>
        </div>

        <div class="filter-item-wrap" style="display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 160px;">
            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">📍 Cơ sở y tế</label>
            <select id="filterFacility" class="filter-select" style="min-width: 160px;">
                <option value="">Tất cả cơ sở</option>
            </select>
        </div>

        <div class="filter-item-wrap" style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">📅 Từ ngày</label>
            <input type="date" id="filterWorkDateFrom" class="filter-select" style="padding: 8px 12px;" />
        </div>

        <div class="filter-item-wrap" style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">📅 Đến ngày</label>
            <input type="date" id="filterWorkDateTo" class="filter-select" style="padding: 8px 12px;" />
        </div>

        <div class="filter-btn-reset-wrap" style="display: flex; flex-direction: column; gap: 5px; justify-content: flex-end;">
            <label style="font-size: 12px; font-weight: 700; color: transparent; text-transform: uppercase; letter-spacing: 0.05em; user-select: none;">reset</label>
            <button id="resetFilterBtn" onclick="resetFilters()" class="filter-btn-reset" style="display: flex; align-items: center; gap: 6px;">
                🔄 Đặt lại
            </button>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="table-scroll">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Bệnh nhân</th>
                    <th>Bác sĩ chuyên khoa</th>
                    <th>Thời gian khám</th>
                    <th>Cơ sở y tế</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="5" style="text-align: center; padding: 40px;">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="pagination" id="pagination"></div>
</div>

<!-- Modal Chi tiết lịch hẹn -->
<div id="appointmentDetailModal" class="modal-overlay" onclick="closeAppointmentModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Chi tiết lịch hẹn</h3>
                    <span id="modalAptIdBadge" class="patient-id-badge" style="font-size: 12px; padding: 3px 8px;"></span>
                </div>
                <p id="modalAptCreatedAt" style="margin: 4px 0 0; font-size: 13px; color: #64748b;"></p>
            </div>
            <div id="modalAptStatusSlot"></div>
        </div>

        <div style="background: #f8fafc; border-radius: 16px; padding: 14px 18px; margin-bottom: 14px; border: 1px solid #f1f5f9;">
            <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #6366f1; letter-spacing: 0.05em; margin-bottom: 10px;">👤 Thông tin bệnh nhân</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 13px;">
                <div>
                    <span style="color: #94a3b8; display: block;">Họ và tên:</span>
                    <b id="modalPatientName" style="color: #1e293b; font-size: 14px;">—</b>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Mã bệnh nhân:</span>
                    <b id="modalPatientId" style="color: #4f46e5; font-size: 14px;">—</b>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Email:</span>
                    <span id="modalPatientEmail" style="color: #1e293b; font-weight: 600;">—</span>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Số điện thoại:</span>
                    <span id="modalPatientPhone" style="color: #1e293b; font-weight: 600;">—</span>
                </div>
            </div>
        </div>

        <div style="background: #f8fafc; border-radius: 16px; padding: 14px 18px; margin-bottom: 14px; border: 1px solid #f1f5f9;">
            <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #6366f1; letter-spacing: 0.05em; margin-bottom: 10px;">👨‍⚕️ Thông tin khám bệnh</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 13px;">
                <div>
                    <span style="color: #94a3b8; display: block;">Bác sĩ phụ trách:</span>
                    <b id="modalDoctorName" style="color: #1e293b; font-size: 14px;">—</b>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Chuyên khoa:</span>
                    <b id="modalSpecialtyName" style="color: #4f46e5; font-size: 14px;">—</b>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Thời gian khám:</span>
                    <b id="modalAppointmentTime" style="color: #1e293b;">—</b>
                </div>
                <div>
                    <span style="color: #94a3b8; display: block;">Cơ sở y tế:</span>
                    <b id="modalFacilityName" style="color: #1e293b;">—</b>
                </div>
                <div style="grid-column: span 2;">
                    <span style="color: #94a3b8; display: block; margin-bottom: 4px;">Lý do khám / Ghi chú:</span>
                    <div id="modalReason" style="background: white; border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 12px; color: #334155; font-size: 13px; line-height: 1.5; white-space: pre-wrap;"></div>
                </div>
            </div>
        </div>

        <!-- Thông tin hủy / từ chối lịch hẹn -->
        <div id="modalCancellationBox" style="display: none; background: #fef2f2; border-radius: 16px; padding: 14px 18px; margin-bottom: 14px; border: 1px solid #fee2e2;">
            <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #dc2626; letter-spacing: 0.05em; margin-bottom: 8px;">❌ Thông tin hủy / từ chối lịch hẹn</div>
            <div style="display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 13px;">
                <div>
                    <span style="color: #991b1b; font-weight: 700;">Người hủy / từ chối:</span>
                    <span id="modalCancelledBy" style="font-weight: 700; color: #b91c1c; margin-left: 6px;">—</span>
                </div>
                <div>
                    <span style="color: #991b1b; font-weight: 700;">Lý do chi tiết:</span>
                    <div id="modalCancellationReason" style="margin-top: 4px; background: white; border: 1px solid #fecaca; border-radius: 8px; padding: 8px 12px; color: #7f1d1d; line-height: 1.5; white-space: pre-wrap;">—</div>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
            <button onclick="closeAppointmentModal()" style="padding: 10px 24px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; font-weight: 700; color: #475569; cursor: pointer; transition: background 0.2s;" onmouseenter="this.style.background='#f1f5f9'" onmouseleave="this.style.background='white'">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        let state = {
            status: '',
            specialtyId: '',
            facilityId: '',
            workDateFrom: '',
            workDateTo: '',
            page: 0,
            size: 10,
            totalPages: 1
        };

        let currentAppointmentsList = [];

        function escapeHtml(value) {
            if (!value) return '';
            const span = document.createElement('span');
            span.textContent = value;
            return span.innerHTML.replaceAll('"', '&quot;').replaceAll("'", '&#39;');
        }

        const getStatusStyle = (status) => {
            const styles = {
                'PENDING': { bg: '#fff7ed', color: '#ea580c', border: '#ffedd5', label: 'Chờ duyệt' },
                'CONFIRMED': { bg: '#eff6ff', color: '#2563eb', border: '#dbeafe', label: 'Đã xác nhận' },
                'COMPLETED': { bg: '#f0fdf4', color: '#16a34a', border: '#dcfce7', label: 'Hoàn thành' },
                'CANCELLED': { bg: '#fef2f2', color: '#dc2626', border: '#fee2e2', label: 'Đã hủy' },
                'NO_SHOW': { bg: '#f8fafc', color: '#64748b', border: '#f1f5f9', label: 'Vắng mặt' }
            };
            return styles[status] || { bg: '#f8fafc', color: '#64748b', border: '#f1f5f9', label: status };
        };

        let requestVersion = 0;
        async function loadAppointments() {
            const version = ++requestVersion;
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #64748b;">Đang tải dữ liệu...</td></tr>';
            
            let query = `?page=${state.page}&size=${state.size}`;
            if (state.status) query += `&status=${state.status}`;
            if (state.specialtyId) query += `&specialtyId=${state.specialtyId}`;
            if (state.facilityId) query += `&facilityId=${state.facilityId}`;
            if (state.workDateFrom) query += `&workDateFrom=${state.workDateFrom}`;
            if (state.workDateTo) query += `&workDateTo=${state.workDateTo}`;

            try {
                const res = await fetch('/api/v1/admin/appointments' + query, {
                    credentials: 'same-origin', cache: 'no-store', signal: AbortSignal.timeout(15000)
                });
                if (!res.ok) throw new Error(await readApiMessage(res));
                const data = await res.json();
                if (version !== requestVersion) return;
                
                const list = data.content || [];
                currentAppointmentsList = list;
                state.totalPages = data.totalPages || 1;

                if (list.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 80px 20px;">
                                <div style="font-size: 48px; margin-bottom: 16px;">📅</div>
                                <div style="color: #1e293b; font-size: 16px; font-weight: 700;">Không có lịch hẹn nào thỏa mãn</div>
                                <div style="color: #64748b; font-size: 13px; margin-top: 4px;">Hãy thử điều chỉnh bộ lọc tìm kiếm.</div>
                            </td>
                        </tr>
                    `;
                } else {
                    tbody.innerHTML = list.map(apt => {
                        const st = getStatusStyle(apt.bookingStatus || apt.status);
                        return `
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                        <span class="patient-id-badge">#${apt.patientId || '—'}</span>
                                        <a href="javascript:void(0)" onclick="openAppointmentModal(${apt.appointmentId})" class="patient-name-link" title="Bấm để xem chi tiết lịch hẹn">${escapeHtml(apt.patientName || 'N/A')}</a>
                                    </div>
                                    <div style="font-size: 12px; color: #64748b; margin-bottom: 2px;">✉️ ${escapeHtml(apt.patientEmail || 'Chưa cập nhật')}</div>
                                    <div style="font-size: 12px; color: #64748b;">📞 ${escapeHtml(apt.patientPhone || 'N/A')}</div>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #1e293b; margin-bottom: 4px;">BS. ${escapeHtml(apt.doctorName || 'N/A')}</div>
                                    <div style="font-size: 12px; color: #4f46e5; font-weight: 700;">${escapeHtml(apt.specialtyName || apt.specialty || '')}</div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: #1e293b; margin-bottom: 4px;">${apt.dateWorking || apt.appointmentDate}</div>
                                    <div style="font-size: 12px; color: #64748b;">${apt.timeSlot || apt.time}</div>
                                </td>
                                <td style="color: #475569; font-size: 13px; font-weight: 500;">
                                    <div style="font-weight: 700;">${escapeHtml(apt.facilityName || 'N/A')}</div>
                                    <div style="font-size: 11px; opacity: 0.8; margin-top: 2px;">${escapeHtml(apt.facilityAddress || '')}</div>
                                </td>
                                <td>
                                    <span class="status-pill" style="background: ${st.bg}; color: ${st.color}; border-color: ${st.border};">
                                        ${st.label}
                                    </span>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
                renderPagination();
            } catch (err) {
                if (version !== requestVersion) return;
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:30px; color:#ef4444;">Không thể tải lịch hẹn. <button onclick="loadAppointments()" style="margin-left:8px; padding:4px 12px; background:#ef4444; color:white; border:none; border-radius:6px; cursor:pointer;">Thử lại</button></td></tr>';
                console.error(err);
            }
        }

        function renderPagination() {
            const pagi = document.getElementById('pagination');
            if (state.totalPages <= 1) {
                pagi.innerHTML = '';
                return;
            }
            
            let html = `<button ${state.page === 0 ? 'disabled' : ''} onclick="changePage(${state.page - 1})">Trang trước</button>`;
            for(let i = 0; i < state.totalPages; i++) {
                if (i >= state.page - 2 && i <= state.page + 2) {
                    html += `<button class="${state.page === i ? 'active' : ''}" onclick="changePage(${i})">${i + 1}</button>`;
                }
            }
            html += `<button ${state.page === state.totalPages - 1 ? 'disabled' : ''} onclick="changePage(${state.page + 1})">Trang sau</button>`;
            pagi.innerHTML = html;
        }

        page.globals.changePage = (p) => {
            state.page = p;
            loadAppointments();
        };

        // Filter clicks
        document.querySelectorAll('.filter-tab').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                state.status = e.target.getAttribute('data-status');
                state.page = 0;
                loadAppointments();
            });
        });

        // Dropdown filters
        document.getElementById('filterSpecialty').addEventListener('change', (e) => {
            state.specialtyId = e.target.value;
            state.page = 0;
            loadAppointments();
        });

        document.getElementById('filterFacility').addEventListener('change', (e) => {
            state.facilityId = e.target.value;
            state.page = 0;
            loadAppointments();
        });

        document.getElementById('filterWorkDateFrom').addEventListener('change', (e) => {
            state.workDateFrom = e.target.value;
            state.page = 0;
            loadAppointments();
        });

        document.getElementById('filterWorkDateTo').addEventListener('change', (e) => {
            state.workDateTo = e.target.value;
            state.page = 0;
            loadAppointments();
        });

        page.globals.resetFilters = function() {
            state.specialtyId = '';
            state.facilityId = '';
            state.workDateFrom = '';
            state.workDateTo = '';
            state.status = '';
            state.page = 0;
            document.getElementById('filterSpecialty').value = '';
            document.getElementById('filterFacility').value = '';
            document.getElementById('filterWorkDateFrom').value = '';
            document.getElementById('filterWorkDateTo').value = '';
            document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
            document.querySelector('.filter-tab[data-status=""]').classList.add('active');
            loadAppointments();
        };

        async function loadCatalogs() {
            try {
                const [specRes, facRes] = await Promise.all([
                    fetch('/api/v1/admin/specialties'),
                    fetch('/api/v1/admin/facilities')
                ]);
                if (specRes.ok) {
                    const specs = await specRes.json();
                    const specSel = document.getElementById('filterSpecialty');
                    specs.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = s.name;
                        specSel.appendChild(opt);
                    });
                }
                if (facRes.ok) {
                    const facs = await facRes.json();
                    const facSel = document.getElementById('filterFacility');
                    facs.forEach(f => {
                        const opt = document.createElement('option');
                        opt.value = f.id;
                        opt.textContent = f.name;
                        facSel.appendChild(opt);
                    });
                }
            } catch (e) {
                console.error("Lỗi tải danh mục bộ lọc:", e);
            }
        }

        // Modal Chi tiết lịch hẹn
        page.globals.openAppointmentModal = function(appointmentId) {
            const apt = currentAppointmentsList.find(a => a.appointmentId === appointmentId);
            if (!apt) return;

            document.getElementById('modalAptIdBadge').innerText = '#APT-' + apt.appointmentId;
            document.getElementById('modalAptCreatedAt').innerText = apt.createdAt ? ('Ngày đặt: ' + new Date(apt.createdAt).toLocaleString('vi-VN')) : '';

            const st = getStatusStyle(apt.bookingStatus || apt.status);
            document.getElementById('modalAptStatusSlot').innerHTML = `<span class="status-pill" style="background: ${st.bg}; color: ${st.color}; border-color: ${st.border};">${st.label}</span>`;

            document.getElementById('modalPatientName').innerText = apt.patientName || 'N/A';
            document.getElementById('modalPatientId').innerText = apt.patientId ? ('#' + apt.patientId) : '—';
            document.getElementById('modalPatientEmail').innerText = apt.patientEmail || 'Chưa cập nhật';
            document.getElementById('modalPatientPhone').innerText = apt.patientPhone || 'Chưa cập nhật';

            document.getElementById('modalDoctorName').innerText = 'BS. ' + (apt.doctorName || 'N/A');
            document.getElementById('modalSpecialtyName').innerText = apt.specialtyName || '—';
            document.getElementById('modalAppointmentTime').innerText = (apt.dateWorking || '—') + ' (' + (apt.timeSlot || '—') + ')';
            document.getElementById('modalFacilityName').innerText = apt.facilityName || '—';
            document.getElementById('modalReason').innerText = apt.reason || 'Không có ghi chú thêm.';

            // Cancellation info
            const cancellationBox = document.getElementById('modalCancellationBox');
            if ((apt.bookingStatus || apt.status) === 'CANCELLED') {
                cancellationBox.style.display = 'block';
                const who = apt.cancelledBy === 'DOCTOR' ? '👨‍⚕️ Bác sĩ từ chối' : (apt.cancelledBy === 'PATIENT' ? '👤 Bệnh nhân hủy' : 'Hệ thống / Quản trị viên');
                document.getElementById('modalCancelledBy').innerText = who;
                document.getElementById('modalCancellationReason').innerText = apt.cancellationReason || 'Không có lý do chi tiết.';
            } else {
                cancellationBox.style.display = 'none';
            }

            document.getElementById('appointmentDetailModal').classList.add('active');
        };

        page.globals.closeAppointmentModal = function() {
            document.getElementById('appointmentDetailModal').classList.remove('active');
        };

        loadCatalogs();
        loadAppointments();

    page.expose({getStatusStyle, escapeHtml, loadAppointments, renderPagination, loadCatalogs});
});
</script>
}
