@{
    ViewData["Title"] = "Quản lý đánh giá";
    Layout = "_AdminLayout";
}

<style>
.admin-card {
    background: #fff; border-radius: 24px; padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;
}
.page-header { margin-bottom: 32px; }
.page-title { margin: 0; font-size: 28px; font-weight: 800; color: #1e293b; }
.page-desc { margin: 8px 0 0; font-size: 15px; color: #64748b; }
.premium-table { width: 100%; border-collapse: collapse; text-align: left; }
.premium-table th {
    padding: 16px 24px; background: #f8fafc; font-size: 11px; font-weight: 700;
    color: #94a3b8; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid #f1f5f9;
}
.premium-table td { padding: 20px 24px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
.premium-table tr:hover { background: #fafbfc; }
.btn-action {
    padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 13px;
    cursor: pointer; border: none; transition: all 0.2s;
}
.btn-hide { background: #fee2e2; color: #ef4444; }
.btn-hide:hover { background: #fca5a5; }
.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
.pagination button {
    padding: 8px 16px; border: 1px solid #e2e8f0; background: #fff;
    border-radius: 8px; cursor: pointer; font-weight: 600; color: #475569;
}
.pagination button.active { background: #6366f1; color: #fff; border-color: #6366f1; }
.pagination button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<div class="page-header">
    <h2 class="page-title">Đánh giá hệ thống</h2>
    <p class="page-desc">Quản lý phản hồi của bệnh nhân dành cho các bác sĩ</p>
</div>

<div class="admin-card">
    <table class="premium-table">
        <thead>
            <tr>
                <th>Khách hàng</th>
                <th>Bác sĩ</th>
                <th>Đánh giá</th>
                <th>Bình luận</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr><td colspan="5" style="text-align: center; padding: 40px;">Đang tải dữ liệu...</td></tr>
        </tbody>
    </table>
    <div class="pagination" id="pagination"></div>
</div>

@section Scripts {
    <script>
        let state = { page: 0, size: 10, totalPages: 1 };

        async function loadReviews() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px;">Đang tải dữ liệu...</td></tr>';
            
            try {
                const res = await fetch(`/api/v1/admin/reviews?page=${state.page}&size=${state.size}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                
                const list = data.content || [];
                state.totalPages = data.totalPages || 1;

                if (list.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 40px; color: #64748b;">Không có đánh giá nào</td></tr>`;
                } else {
                    tbody.innerHTML = list.map(r => `
                        <tr>
                            <td>
                                <div style="font-weight: 700; color: #1e293b;">${r.patientName || 'N/A'}</div>
                                <div style="font-size: 12px; color: #64748b;">${r.createdAt ? new Date(r.createdAt).toLocaleDateString() : ''}</div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #1e293b;">BS. ${r.doctorName || 'N/A'}</div>
                            </td>
                            <td>
                                <div style="color: #f59e0b; font-weight: 700;">★ ${r.rating}</div>
                            </td>
                            <td style="max-width: 300px;">
                                <p style="margin: 0; color: #475569; font-size: 13px; line-height: 1.5;">${r.comment || '<i style="color: #94a3b8">Không có bình luận</i>'}</p>
                            </td>
                            <td>
                                <button class="btn-action btn-hide" onclick="hideReview(${r.id || r.reviewId})">Ẩn / Xóa</button>
                            </td>
                        </tr>
                    `).join('');
                }
                renderPagination();
            } catch (err) {
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">Lỗi tải dữ liệu</td></tr>';
            }
        }

        window.hideReview = async (id) => {
            if (!confirm('Bạn có chắc chắn muốn ẩn/xóa đánh giá này?')) return;
            try {
                const res = await fetch(`/api/v1/admin/reviews/${id}/hide`, { 
                    method: 'PATCH',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    Toastify({ text: "Đã ẩn đánh giá", style: { background: "#10b981" } }).showToast();
                    loadReviews();
                } else {
                    Toastify({ text: "Lỗi khi ẩn", style: { background: "#ef4444" } }).showToast();
                }
            } catch(e) { console.error(e); }
        };

        function renderPagination() {
            const pagi = document.getElementById('pagination');
            if (state.totalPages <= 1) { pagi.innerHTML = ''; return; }
            let html = `<button ${state.page === 0 ? 'disabled' : ''} onclick="changePage(${state.page - 1})">←</button>`;
            for(let i = 0; i < state.totalPages; i++) {
                if (i >= state.page - 2 && i <= state.page + 2) {
                    html += `<button class="${state.page === i ? 'active' : ''}" onclick="changePage(${i})">${i + 1}</button>`;
                }
            }
            html += `<button ${state.page === state.totalPages - 1 ? 'disabled' : ''} onclick="changePage(${state.page + 1})">→</button>`;
            pagi.innerHTML = html;
        }

        window.changePage = (p) => { state.page = p; loadReviews(); };

        loadReviews();
    </script>
}
