@{
    ViewData["Title"] = "Quản lý đánh giá";
    Layout = "_AdminLayout";
}

<style>
.admin-card {
    background: #fff; border-radius: 24px; padding: 28px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;
}
.page-header { margin-bottom: 28px; }
.page-title { margin: 0; font-size: 28px; font-weight: 800; color: #1e293b; }
.page-desc { margin: 8px 0 0; font-size: 15px; color: #64748b; }

.filter-bar {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
    gap: 16px; margin-bottom: 24px;
}
.tab-group {
    display: flex; gap: 8px; background: #f1f5f9; padding: 4px; border-radius: 14px;
}
.tab-btn {
    padding: 8px 16px; border: none; background: transparent; border-radius: 10px;
    font-size: 13px; font-weight: 700; color: #64748b; cursor: pointer; transition: all 0.2s;
}
.tab-btn.active {
    background: #fff; color: #6366f1; box-shadow: 0 2px 6px rgba(0,0,0,0.06);
}
.tab-btn.warning-tab.active {
    background: #fff; color: #dc2626; box-shadow: 0 2px 6px rgba(220,38,38,0.15);
}

.search-box {
    display: flex; align-items: center; background: #f8fafc; border: 1.5px solid #e2e8f0;
    border-radius: 14px; padding: 8px 14px; width: 320px; max-width: 100%; transition: border-color 0.2s;
}
.search-box:focus-within {
    border-color: #6366f1; background: #fff; box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
}
.search-box input {
    border: none; background: transparent; outline: none; width: 100%; font-size: 14px; color: #1e293b;
}

.premium-table { width: 100%; border-collapse: collapse; text-align: left; }
.premium-table th {
    padding: 16px 20px; background: #f8fafc; font-size: 11px; font-weight: 700;
    color: #94a3b8; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 1px solid #f1f5f9;
}
.premium-table td { padding: 18px 20px; border-bottom: 1px solid #f1f5f9; font-size: 14px; vertical-align: top; }
.premium-table tr:hover { background: #fafbfc; }

.badge-status { display: inline-block; white-space: nowrap; font-size: 12px; font-weight: 700; }
.badge-visible { color: #059669; }
.badge-hidden { color: #64748b; }

.btn-action {
    padding: 8px 16px; border-radius: 10px; font-weight: 700; font-size: 13px;
    cursor: pointer; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;
}
.btn-hide { background: #fee2e2; color: #ef4444; }
.btn-hide:hover { background: #fca5a5; }
.btn-unhide { background: #dcfce7; color: #16a34a; }
.btn-unhide:hover { background: #bbf7d0; }

.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
.pagination button {
    padding: 8px 16px; border: 1px solid #e2e8f0; background: #fff;
    border-radius: 8px; cursor: pointer; font-weight: 600; color: #475569;
}
.pagination button.active { background: #6366f1; color: #fff; border-color: #6366f1; }
.pagination button:disabled { opacity: 0.5; cursor: not-allowed; }

.modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.3s;
    padding: 20px; box-sizing: border-box;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-content {
    background: white; border-radius: 24px; padding: 32px; width: 100%; max-width: 480px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); transform: scale(0.95); transition: transform 0.3s;
    box-sizing: border-box; max-height: 90vh; overflow-y: auto;
}
.modal-overlay.active .modal-content { transform: scale(1); }

@@media (max-width: 640px) {
    .filter-bar {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 14px !important;
    }
    .tab-group {
        width: 100% !important;
        overflow-x: auto !important;
        box-sizing: border-box !important;
    }
    .search-box {
        width: 100% !important;
        box-sizing: border-box !important;
    }
    .admin-card {
        padding: 16px !important;
    }
    .modal-content {
        padding: 20px 16px !important;
        border-radius: 20px !important;
    }
}
</style>

<div class="page-header">
    <h2 class="page-title">Đánh giá hệ thống</h2>
    <p class="page-desc">Naive Bayes gợi ý bài cần xem xét. Admin quyết định ẩn nội dung; số sao vẫn được tính.</p>
</div>

<!-- Modal Xác nhận Ẩn/Hiện Đánh giá -->
<div id="toggleReviewModal" class="modal-overlay" onclick="closeToggleReviewModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
            <div id="toggleReviewIconBox" style="width: 48px; height: 48px; border-radius: 14px; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">
                🚫
            </div>
            <div style="flex: 1;">
                <h3 id="toggleReviewTitle" style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Xác nhận ẩn đánh giá</h3>
                <p id="toggleReviewSub" style="margin: 4px 0 0; color: #64748b; font-size: 13px;">Nội dung bình luận sẽ bị ẩn khỏi trang công khai.</p>
            </div>
            <button type="button" onclick="closeToggleReviewModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 18px; display: flex; align-items: center; justify-content: center;">✕</button>
        </div>

        <div id="toggleReviewCommentBox" style="background: #f8fafc; border-radius: 14px; padding: 14px 16px; margin-bottom: 20px; border: 1px solid #e2e8f0; font-size: 13px; color: #334155; line-height: 1.5; max-height: 120px; overflow-y: auto;">
            <span style="color: #64748b; display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">Nội dung đánh giá:</span>
            <span id="toggleReviewCommentText" style="font-style: italic;">—</span>
        </div>

        <p style="font-size: 13px; color: #64748b; margin: 0 0 24px; line-height: 1.4;">
            💡 <em>Lưu ý: Điểm số số sao của đánh giá này vẫn được bảo lưu và tính vào điểm trung bình của bác sĩ.</em>
        </p>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" onclick="closeToggleReviewModal()" style="padding: 11px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">
                Quay lại
            </button>
            <button type="button" id="confirmToggleReviewBtn" onclick="confirmToggleReview()" style="padding: 11px 24px; border-radius: 12px; border: none; background: #ef4444; color: white; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25); transition: all 0.2s;">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="filter-bar">
        <div class="tab-group">
            <button class="tab-btn active" onclick="setTab('all', this)">Tất cả</button>
            <button class="tab-btn" onclick="setTab('visible', this)">Đang hiển thị</button>
            <button class="tab-btn" onclick="setTab('hidden', this)">Đã ẩn</button>
            <button class="tab-btn warning-tab" onclick="setTab('profane', this)">⚠️ Nghi vấn thô tục</button>
            <button class="tab-btn warning-tab" onclick="setTab('spam', this)">Nghi vấn spam</button>
            <button class="tab-btn warning-tab" onclick="setTab('advertising', this)">Nghi vấn quảng cáo</button>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748b; font-weight: 600;">
                <label for="reviewPageSizeSelect">Hiển thị:</label>
                <select id="reviewPageSizeSelect" onchange="changeReviewPageSize(this.value)" style="padding: 7px 12px; border-radius: 10px; border: 1.5px solid #cbd5e1; background: #fff; font-size: 13px; font-weight: 600; color: #1e293b; outline: none; cursor: pointer;">
                    <option value="3">3 / trang</option>
                    <option value="5" selected>5 / trang</option>
                    <option value="10">10 / trang</option>
                    <option value="20">20 / trang</option>
                </select>
            </div>
            <div class="search-box">
                <span style="color: #94a3b8; margin-right: 8px;">🔍</span>
                <input type="text" id="searchKeyword" placeholder="Tìm theo tên hoặc nội dung..." oninput="handleSearch()" />
            </div>
        </div>
    </div>

    <div class="table-scroll">
        <table class="premium-table">
            <thead>
                <tr>
                    <th style="width: 22%;">Khách hàng</th>
                    <th style="width: 20%;">Bác sĩ</th>
                    <th style="width: 12%;">Đánh giá</th>
                    <th style="width: 30%;">Bình luận</th>
                    <th style="width: 16%;">Trạng thái & Hành động</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="5" style="text-align: center; padding: 40px;">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
    <div id="reviewPaginationWrapper" style="display: none; flex-direction: column; align-items: center; gap: 12px; margin-top: 28px;">
        <div class="pagination" id="pagination"></div>
        <div id="reviewPaginationInfo" style="font-size: 13px; color: #64748b; font-weight: 600;"></div>
    </div>
</div>

@section Scripts {
    <script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        let rawReviews = [];
        let filteredReviews = [];
        let state = { page: 0, size: 5, totalPages: 1, totalElements: 0 };
        let currentTab = 'all';
        let searchKeyword = '';

        function suggestedLabel(scores) {
            const entries = Object.entries(scores || {}).sort((a, b) => b[1] - a[1]);
            return entries.length && entries[0][0] !== 'Thông thường' && entries[0][1] >= 60 ? entries[0][0] : '';
        }
        let reviewRequestVersion = 0;
        async function loadReviews() {
            const version = ++reviewRequestVersion;
            const tbody = document.getElementById('tableBody');
            const wrapper = document.getElementById('reviewPaginationWrapper');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px;">Đang tải dữ liệu...</td></tr>';
            if (wrapper) wrapper.style.display = 'none';
            
            try {
                const res = await fetch(`/api/v1/admin/reviews?page=${state.page}&size=${state.size}&category=${currentTab}&search=${encodeURIComponent(searchKeyword)}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) throw new Error(await readApiMessage(res));
                const data = await res.json();
                if (version !== reviewRequestVersion) return;
                
                rawReviews = data.content || [];
                state.totalPages = data.totalPages || 1;
                state.totalElements = data.totalElements != null ? data.totalElements : rawReviews.length;
                if (state.page >= state.totalPages) {
                    state.page = Math.max(0, state.totalPages - 1);
                    loadReviews();
                    return;
                }
                applyFilter();
            } catch (err) {
                if (version !== reviewRequestVersion) return;
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">Lỗi tải dữ liệu</td></tr>';
            }
        }

        function setTab(tab, btn) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.page = 0; loadReviews();
        }

        function handleSearch() {
            searchKeyword = document.getElementById('searchKeyword').value.trim().toLowerCase();
            state.page = 0; clearTimeout(window.reviewSearchTimer); page.globals.reviewSearchTimer = setTimeout(loadReviews, 300);
        }

        function applyFilter() {
            filteredReviews = rawReviews;
            renderTable();
        }

        function highlightProfanity(text) {
            if (!text) return '<i style="color: #94a3b8">Không có bình luận</i>';
            let escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return escaped;
        }

        function renderTable() {
            const tbody = document.getElementById('tableBody');
            if (filteredReviews.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 40px; color: #64748b;">Không tìm thấy đánh giá nào phù hợp</td></tr>`;
                renderPagination();
                return;
            }

            tbody.innerHTML = filteredReviews.map(r => {
                const id = r.id || r.reviewId;
                const isHidden = (r.isVisible === false);
                const isToxic = suggestedLabel(r.aiLabels);

                return `
                    <tr style="${isHidden ? 'background: #fcfcfd; opacity: 0.8;' : ''}">
                        <td>
                            <div style="font-weight: 700; color: #1e293b;">${escapeHtml(r.patientName || 'N/A')}</div>
                            <div style="font-size: 12px; color: #64748b; margin-top: 2px;">${r.createdAt ? new Date(r.createdAt).toLocaleDateString('vi-VN') : ''}</div>
                        </td>
                        <td>
                            <div style="font-weight: 700; color: #1e293b;">BS. ${escapeHtml(r.doctorName || 'N/A')}</div>
                        </td>
                        <td>
                            <div style="color: #f59e0b; font-weight: 800; font-size: 15px;">★ ${r.rating}</div>
                            <div style="font-size: 11px; color: #94a3b8; margin-top: 2px;">Đánh giá sao</div>
                        </td>
                        <td style="max-width: 320px;">
                            <p style="margin: 0; color: #475569; font-size: 13px; line-height: 1.5;">${isHidden ? 'Nội dung tiêu cực đã được ẩn' : highlightProfanity(r.comment)}</p>
                            ${isToxic ? `<div class="badge-toxic">⚠️ Nghi vấn ${isToxic}</div>` : ''}
                        </td>
                        <td>
                            <div style="margin-bottom: 8px;">
                                ${isHidden 
                                    ? '<span class="badge-status badge-hidden">● Đã ẩn</span>' 
                                    : '<span class="badge-status badge-visible">● Đang hiển thị</span>'}
                            </div>
                            <button class="btn-action ${isHidden ? 'btn-unhide' : 'btn-hide'}" data-comment="${escapeHtml(r.comment)}" onclick="openToggleReviewModal(${id}, ${isHidden}, this.dataset.comment)">
                                ${isHidden ? '👁️ Hiện lại' : '🚫 Ẩn'}
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            renderPagination();
        }

        let targetToggleReviewId = null;
        let targetToggleIsHidden = false;

        page.globals.openToggleReviewModal = function(id, isCurrentlyHidden, comment) {
            targetToggleReviewId = id;
            targetToggleIsHidden = isCurrentlyHidden;

            const iconBox = document.getElementById('toggleReviewIconBox');
            const title = document.getElementById('toggleReviewTitle');
            const sub = document.getElementById('toggleReviewSub');
            const commentText = document.getElementById('toggleReviewCommentText');
            const confirmBtn = document.getElementById('confirmToggleReviewBtn');

            if (isCurrentlyHidden) {
                iconBox.innerHTML = '👁️';
                iconBox.style.background = '#dcfce7';
                iconBox.style.color = '#16a34a';
                title.innerText = 'Xác nhận hiện lại đánh giá';
                sub.innerText = 'Nội dung bình luận sẽ được hiển thị công khai trở lại trên trang bác sĩ.';
                confirmBtn.style.background = '#16a34a';
                confirmBtn.innerText = 'Hiện lại đánh giá';
            } else {
                iconBox.innerHTML = '🚫';
                iconBox.style.background = '#fee2e2';
                iconBox.style.color = '#ef4444';
                title.innerText = 'Xác nhận ẩn đánh giá';
                sub.innerText = 'Nội dung bình luận sẽ bị ẩn khỏi trang công khai của bác sĩ.';
                confirmBtn.style.background = '#ef4444';
                confirmBtn.innerText = 'Ẩn đánh giá';
            }

            commentText.innerText = comment ? `"${comment}"` : '(Không có nội dung bình luận)';
            confirmBtn.disabled = false;
            document.getElementById('toggleReviewModal').classList.add('active');
        };

        page.globals.closeToggleReviewModal = function() {
            document.getElementById('toggleReviewModal').classList.remove('active');
            targetToggleReviewId = null;
        };

        page.globals.confirmToggleReview = async function() {
            if (!targetToggleReviewId) return;
            const btn = document.getElementById('confirmToggleReviewBtn');
            btn.disabled = true;
            btn.innerText = 'Đang xử lý...';

            try {
                const res = await fetch(`/api/v1/admin/reviews/${targetToggleReviewId}/hide`, { 
                    method: 'PATCH',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    page.globals.closeToggleReviewModal();
                    Toastify({ 
                        text: targetToggleIsHidden ? "Đã hiển thị lại đánh giá" : "Đã ẩn đánh giá", 
                        style: { background: "#10b981" } 
                    }).showToast();
                    loadReviews();
                } else {
                    Toastify({ text: "Lỗi khi cập nhật trạng thái", style: { background: "#ef4444" } }).showToast();
                    btn.disabled = false;
                    btn.innerText = 'Xác nhận';
                }
            } catch(e) {
                console.error(e);
                Toastify({ text: "Lỗi mạng", style: { background: "#ef4444" } }).showToast();
                btn.disabled = false;
                btn.innerText = 'Xác nhận';
            }
        };

        page.globals.toggleHideReview = page.globals.openToggleReviewModal;

        function renderPagination() {
            const wrapper = document.getElementById('reviewPaginationWrapper');
            const pagi = document.getElementById('pagination');
            const info = document.getElementById('reviewPaginationInfo');
            if (!wrapper || !pagi) return;

            if (state.totalElements === 0) {
                wrapper.style.display = 'none';
                return;
            }

            wrapper.style.display = 'flex';

            const fromItem = state.page * state.size + 1;
            const toItem = Math.min((state.page + 1) * state.size, state.totalElements);
            if (info) {
                info.innerHTML = `Hiển thị <strong>${fromItem} - ${toItem}</strong> trên tổng số <strong>${state.totalElements}</strong> đánh giá (Trang ${state.page + 1}/${Math.max(1, state.totalPages)})`;
            }

            renderAdminPagination(pagi, state.page, Math.max(1, state.totalPages), page.globals.changePage);
        }

        page.globals.changePage = (p) => {
            if (p < 0 || (state.totalPages > 0 && p >= state.totalPages)) return;
            state.page = p;
            loadReviews();
            document.querySelector('.table-scroll')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        page.globals.changeReviewPageSize = function(newSize) {
            state.size = parseInt(newSize) || 5;
            state.page = 0;
            loadReviews();
        };

        loadReviews();

    page.expose({suggestedLabel, loadReviews, setTab, handleSearch, applyFilter, highlightProfanity, renderTable, renderPagination, changePage: page.globals.changePage, changeReviewPageSize: page.globals.changeReviewPageSize, openToggleReviewModal: page.globals.openToggleReviewModal, closeToggleReviewModal: page.globals.closeToggleReviewModal, confirmToggleReview: page.globals.confirmToggleReview});
});
</script>
}
