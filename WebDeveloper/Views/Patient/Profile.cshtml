@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "_PatientLayout";
}

<div class="reveal">
    <div style="max-width: 600px; margin: 0 auto; background: white; border-radius: 16px; padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="font-size: 24px; font-weight: 700; margin: 0; color: #0f172a;">Thông tin cá nhân</h2>
        </div>
        
        <div id="messageBox" style="display: none; padding: 12px 16px; border-radius: 8px; margin-bottom: 24px; font-size: 14px;"></div>

        <form id="profileForm" onsubmit="handleSubmit(event)">
            <!-- Avatar Upload -->
            <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 32px;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: #e2e8f0; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                    <img id="avatarPreview" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                    <span id="avatarInitials" style="font-size: 32px; color: #94a3b8;">U</span>
                </div>
                <div>
                    <label style="padding: 8px 16px; border-radius: 8px; background: #f1f5f9; color: #475569; font-size: 14px; font-weight: 600; cursor: pointer; display: inline-block; transition: background 0.2s;" onmouseenter="this.style.background='#e2e8f0'" onmouseleave="this.style.background='#f1f5f9'">
                        Đổi ảnh đại diện
                        <input type="file" id="fileInput" accept="image/*" style="display: none;" onchange="handleFileChange(event)" />
                    </label>
                    <p style="margin: 8px 0 0; font-size: 12px; color: #94a3b8;">JPG, PNG. Max 5MB.</p>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px;">Email (Không thể thay đổi)</label>
                    <input type="email" id="email" disabled style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc; color: #94a3b8; box-sizing: border-box; font-family: inherit;" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px;">Họ và tên</label>
                    <input type="text" id="fullName" required style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid #cbd5e1; box-sizing: border-box; font-family: inherit; transition: border-color 0.2s;" onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='#cbd5e1'" />
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px;">Số điện thoại</label>
                    <input type="tel" id="phoneNumber" style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid #cbd5e1; box-sizing: border-box; font-family: inherit; transition: border-color 0.2s;" onfocus="this.style.borderColor='#6366f1'" onblur="this.style.borderColor='#cbd5e1'" />
                </div>
            </div>

            <button type="submit" id="submitBtn" style="margin-top: 32px; width: 100%; padding: 14px; border-radius: 8px; border: none; background: #6366f1; color: white; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: inherit;" onmouseenter="if(!this.disabled){this.style.background='#4f46e5'}" onmouseleave="if(!this.disabled){this.style.background='#6366f1'}">
                Lưu thay đổi
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem('token');
        const userStr = localStorage.getItem('user');
        if (!token || !userStr) {
            window.location.href = '/Auth/Login';
        }

        let file = null;
        let currentUser = null;

        try {
            currentUser = JSON.parse(userStr);
            document.getElementById('email').value = currentUser.email || '';
            document.getElementById('fullName').value = currentUser.fullName || '';
            document.getElementById('phoneNumber').value = currentUser.phoneNumber || '';
            
            if (currentUser.avatarUrl) {
                document.getElementById('avatarPreview').src = currentUser.avatarUrl;
                document.getElementById('avatarPreview').style.display = 'block';
                document.getElementById('avatarInitials').style.display = 'none';
            } else {
                document.getElementById('avatarInitials').innerText = (currentUser.fullName || currentUser.email || 'U').charAt(0).toUpperCase();
            }
        } catch(e) {}

        window.handleFileChange = function(e) {
            const f = e.target.files[0];
            if (f) {
                file = f;
                document.getElementById('avatarPreview').src = URL.createObjectURL(f);
                document.getElementById('avatarPreview').style.display = 'block';
                document.getElementById('avatarInitials').style.display = 'none';
            }
        };

        function showMessage(text, type) {
            const box = document.getElementById('messageBox');
            box.style.display = 'block';
            box.innerText = text;
            if (type === 'success') {
                box.style.background = '#ecfdf5';
                box.style.color = '#059669';
            } else {
                box.style.background = '#fef2f2';
                box.style.color = '#dc2626';
            }
        }

        window.handleSubmit = function(e) {
            e.preventDefault();
            
            const fullName = document.getElementById('fullName').value.trim();
            const phone = document.getElementById('phoneNumber').value.trim();
            
            if (!fullName) {
                showMessage("Họ và tên không được để trống.", "error");
                return;
            }

            const phoneRegex = /^[0-9]{10}$/;
            if (phone && !phoneRegex.test(phone)) {
                showMessage("Số điện thoại phải gồm 10 chữ số, ví dụ: 0912345678", "error");
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = 'Đang lưu...';
            btn.style.opacity = '0.7';

            const formData = new FormData();
            formData.append('fullName', fullName);
            formData.append('phoneNumber', phone);
            if (file) {
                formData.append('file', file);
            }

            fetch('/api/v1/user/profile', {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            })
            .then(async res => {
                if (res.ok) {
                    const updatedUser = await res.json();
                    localStorage.setItem('user', JSON.stringify(updatedUser));
                    document.cookie = `user_info=${encodeURIComponent(JSON.stringify(updatedUser))}; path=/;`;
                    showMessage("Cập nhật thông tin thành công!", "success");
                    
                    // Update layout avatar and name
                    const layoutName = document.querySelector('header span');
                    if (layoutName) layoutName.innerText = updatedUser.fullName;
                } else {
                    const msg = await res.text();
                    showMessage(msg || "Đã xảy ra lỗi khi cập nhật", "error");
                }
            })
            .catch(() => showMessage("Đã xảy ra lỗi khi cập nhật", "error"))
            .finally(() => {
                btn.disabled = false;
                btn.innerText = 'Lưu thay đổi';
                btn.style.opacity = '1';
            });
        };
    </script>
}
