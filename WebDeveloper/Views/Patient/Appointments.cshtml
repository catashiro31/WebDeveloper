@{
    ViewData["Title"] = "Lịch hẹn sắp tới";
    Layout = "_PatientLayout";
}

<style>




.quick-reason-btn {
    padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc;
    color: #475569; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.quick-reason-btn:hover { background: #fee2e2; border-color: #fecaca; color: #dc2626; }
@@media (max-width: 640px) {
    .premium-card {
        flex-direction: column !important;
        align-items: flex-start !important;
        padding: 16px !important;
        gap: 16px !important;
    }
    .premium-card > div:last-child {
        padding-left: 0 !important;
        width: 100% !important;
    }
    .premium-card > div:last-child button {
        width: 100% !important;
        justify-content: center !important;
        min-height: 44px !important;
    }

}
</style>

<div class="reveal">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
        <h2 style="margin: 0; font-size: 20px; font-weight: 800; color: #1e293b;">Lịch hẹn sắp tới</h2>
        <span id="appointmentCount" style="font-size: 13px; color: #64748b; font-weight: 600;">Tất cả (0)</span>
    </div>
    
    <div id="appointmentsContainer" style="display: flex; flex-direction: column; gap: 20px;">
        <!-- Skeletons -->
        <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
        <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
        <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
    </div>
</div>

<!-- Modal Hủy lịch hẹn của Bệnh nhân -->
<div id="patientCancelModal" class="modal-overlay" onclick="closePatientCancelModal()" style="--modal-max-width: 500px; --modal-padding: 32px; --modal-border-radius: 28px; ">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px;">
            <div style="width: 48px; height: 48px; border-radius: 16px; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">
                ⚠️
            </div>
            <div style="flex: 1;">
                <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Hủy lịch hẹn khám bệnh</h3>
                <p style="margin: 4px 0 0; color: #64748b; font-size: 13px;">Bạn có chắc chắn muốn hủy lịch hẹn khám này? Bác sĩ sẽ nhận được thông báo về việc hủy hẹn.</p>
            </div>
            <button type="button" onclick="closePatientCancelModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 18px; display: flex; align-items: center; justify-content: center;">✕</button>
        </div>

        <div id="patientCancelAptInfo" style="background: #f8fafc; border-radius: 14px; padding: 12px 16px; margin-bottom: 18px; border: 1px solid #e2e8f0; font-size: 13px; color: #334155;">
            <div>Bác sĩ khám: <b id="cancelModalDoctorName" style="color: #0f172a;">—</b></div>
            <div style="margin-top: 4px; color: #64748b;">Thời gian: <span id="cancelModalTime" style="font-weight: 600; color: #475569;">—</span></div>
            <div style="margin-top: 4px; color: #64748b;">Cơ sở: <span id="cancelModalFacility" style="color: #475569;">—</span></div>
        </div>

        <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 11px; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.05em;">Chọn nhanh lý do</label>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <button type="button" class="quick-reason-btn" onclick="selectPatientReason('Bận việc gia đình / công việc đột xuất')">Bận đột xuất</button>
                <button type="button" class="quick-reason-btn" onclick="selectPatientReason('Sức khỏe đã ổn định hơn')">Sức khỏe đã ổn</button>
                <button type="button" class="quick-reason-btn" onclick="selectPatientReason('Muốn đổi sang ngày hoặc giờ khám khác')">Đổi lịch khác</button>
                <button type="button" class="quick-reason-btn" onclick="selectPatientReason('Đã đi khám tại cơ sở y tế khác')">Đã khám nơi khác</button>
            </div>
        </div>

        <div style="margin-bottom: 24px;">
            <label for="patientCancelReasonInput" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 8px;">
                Lý do hủy lịch <span style="color: #ef4444;">*</span>
            </label>
            <textarea id="patientCancelReasonInput" placeholder="Nhập lý do bạn muốn hủy lịch hẹn..." rows="3" style="width: 100%; padding: 12px 14px; border-radius: 12px; border: 1.5px solid #cbd5e1; font-size: 14px; color: #1e293b; outline: none; font-family: inherit; box-sizing: border-box; resize: vertical; min-height: 85px; transition: border-color 0.2s;" onfocus="this.style.borderColor='#ef4444'" onblur="this.style.borderColor='#cbd5e1'"></textarea>
            <div id="patientCancelError" style="display: none; color: #ef4444; font-size: 12px; font-weight: 600; margin-top: 6px;">Vui lòng nhập lý do hủy lịch hẹn.</div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" onclick="closePatientCancelModal()" style="padding: 11px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">
                Quay lại
            </button>
            <button type="button" id="confirmPatientCancelBtn" onclick="confirmPatientCancel()" style="padding: 11px 24px; border-radius: 12px; border: none; background: #ef4444; color: white; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25); transition: all 0.2s;" onmouseenter="this.style.background='#dc2626'" onmouseleave="this.style.background='#ef4444'">
                Xác nhận hủy
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/Auth/Login';
        }

        const container = document.getElementById('appointmentsContainer');
        const countSpan = document.getElementById('appointmentCount');

        let currentAppointments = [];
        let currentCancelAptId = null;

        function fetchAppointments() {
            container.innerHTML = `
                <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
                <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
                <div class="skeleton" style="height: 120px; width: 100%; border-radius: 16px;"></div>
            `;

            fetch('/api/v1/patient/appointments?page=0&size=100', {
                headers: { 'Authorization': `Bearer ${token}` }
            })
            .then(async res => {
                if (!res.ok) throw new Error(await readApiMessage(res));
                return res.json();
            })
            .then(data => {
                const list = (data.content || data || []).filter(apt => ['PENDING', 'CONFIRMED'].includes(apt.bookingStatus));
                currentAppointments = list;
                countSpan.innerText = `Tất cả (${list.length})`;
                renderAppointments(list);
            })
            .catch(err => {
                console.error(err);
                container.innerHTML = `
                    <div style="text-align: center; padding: 60px;">
                        <div style="font-size: 48px; margin-bottom: 16px;">⚠️</div>
                        <h3 style="color: #ef4444; margin: 0 0 8px;">Lỗi tải dữ liệu</h3>
                        <p style="color: #64748b;">Không thể tải danh sách lịch hẹn</p>
                        <button onclick="fetchAppointments()" style="margin-top: 16px; color: #6366f1; background: none; border: none; font-weight: 600; cursor: pointer;">Thử lại</button>
                    </div>
                `;
            });
        }

        function getStatusStyles(status) {
            switch (status) {
                case 'PENDING':
                    return { bg: 'rgba(245, 158, 11, 0.1)', color: '#d97706', border: 'rgba(245, 158, 11, 0.2)', text: 'Chờ xác nhận' };
                case 'CONFIRMED':
                    return { bg: 'rgba(16, 185, 129, 0.1)', color: '#059669', border: 'rgba(16, 185, 129, 0.2)', text: 'Đã xác nhận' };
                default:
                    return { bg: '#f1f5f9', color: '#64748b', border: '#e2e8f0', text: status };
            }
        }

        page.globals.openPatientCancelModal = function(id) {
            currentCancelAptId = id;
            const apt = currentAppointments.find(a => (a.appointmentId || a.id) == id);
            document.getElementById('cancelModalDoctorName').innerText = apt ? `BS. ${apt.doctorName}` : '—';
            document.getElementById('cancelModalTime').innerText = apt ? `${apt.dateWorking} (${apt.timeSlot || apt.startTime || '—'})` : '—';
            document.getElementById('cancelModalFacility').innerText = apt ? (apt.facilityName || '—') : '—';
            document.getElementById('patientCancelReasonInput').value = '';
            document.getElementById('patientCancelError').style.display = 'none';
            document.getElementById('confirmPatientCancelBtn').disabled = false;
            document.getElementById('confirmPatientCancelBtn').innerText = 'Xác nhận hủy';
            document.getElementById('patientCancelModal').classList.add('active');
        };

        page.globals.closePatientCancelModal = function() {
            document.getElementById('patientCancelModal').classList.remove('active');
            currentCancelAptId = null;
        };

        page.globals.selectPatientReason = function(txt) {
            const input = document.getElementById('patientCancelReasonInput');
            input.value = txt;
            document.getElementById('patientCancelError').style.display = 'none';
            input.focus();
        };

        page.globals.confirmPatientCancel = function() {
            if (!currentCancelAptId) return;
            const reason = document.getElementById('patientCancelReasonInput').value.trim();
            if (!reason) {
                document.getElementById('patientCancelError').style.display = 'block';
                return;
            }

            const btn = document.getElementById('confirmPatientCancelBtn');
            btn.disabled = true;
            btn.innerText = 'Đang xử lý...';

            fetch(`/api/v1/patient/appointments/${currentCancelAptId}/cancel?reason=${encodeURIComponent(reason)}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            })
            .then(async res => {
                if (res.ok) {
                    closePatientCancelModal();
                    showApiToast("Đã hủy lịch hẹn thành công", "success");
                    fetchAppointments();
                } else {
                    const msg = await readApiMessage(res);
                    showApiToast(msg || "Không thể hủy lịch hẹn", "error");
                    btn.disabled = false;
                    btn.innerText = 'Xác nhận hủy';
                }
            })
            .catch(() => {
                showApiToast("Không thể hủy lịch hẹn", "error");
                btn.disabled = false;
                btn.innerText = 'Xác nhận hủy';
            });
        };

        function renderAppointments(list) {
            if (list.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 80px 40px; color: #64748b;">
                        <div style="width: 80px; height: 80px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 32px;">📅</div>
                        <h3 style="color: #1e293b; margin: 0 0 8px; font-size: 20px; font-weight: 800;">Bạn chưa có lịch hẹn nào</h3>
                        <p style="margin: 0 0 24px; max-width: 300px; margin-inline: auto;">Bắt đầu chăm sóc sức khỏe của bạn bằng cách đặt lịch khám với các bác sĩ hàng đầu.</p>
                        <a href="/Portal/Doctors" style="display: inline-block; padding: 12px 32px; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; text-decoration: none; border-radius: 12px; font-weight: 700; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);">Đặt lịch ngay</a>
                    </div>
                `;
                return;
            }

            let html = '';
            list.forEach(apt => {
                const status = getStatusStyles(apt.bookingStatus);
                html += `
                    <div class="premium-card" style="padding: 24px; display: flex; justify-content: space-between; align-items: center; border-left: 4px solid ${status.color};">
                        <div style="flex: 1;">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #1e293b;">BS. ${escapeHtml(apt.doctorName)}</h3>
                                <span style="padding: 4px 12px; border-radius: 8px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; background: ${status.bg}; color: ${status.color}; border: 1px solid ${status.border};">${status.text}</span>
                            </div>
                            
                            <div style="display: grid; grid-template-columns: auto 1fr; gap: 12px 24px; color: #475569; font-size: 14px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="opacity: 0.7;">📅</span>
                                    <span style="font-weight: 600;">${apt.dateWorking}</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="opacity: 0.7;">⏰</span>
                                    <span style="font-weight: 600;">${apt.timeSlot || apt.startTime}</span>
                                </div>
                                <div style="grid-column: span 2; display: flex; align-items: center; gap: 8px;">
                                    <span style="opacity: 0.7;">📍</span>
                                    <span style="color: #64748b;">
                                        ${escapeHtml(apt.facilityName)}
                                        ${apt.facilityAddress ? `<span style="display: block; font-size: 12px; margin-top: 2px; opacity: 0.8;">${escapeHtml(apt.facilityAddress)}${apt.facilityProvince ? `, ${escapeHtml(apt.facilityProvince)}` : ''}</span>` : ''}
                                    </span>
                                </div>
                                ${apt.reason ? `
                                    <div style="grid-column: span 2; display: flex; align-items: flex-start; gap: 8px; background: #f8fafc; padding: 10px 14px; border-radius: 10px; margin-top: 4px;">
                                        <span style="opacity: 0.7;">📝</span>
                                        <span style="font-size: 13px; line-height: 1.5;">${escapeHtml(apt.reason)}</span>
                                    </div>
                                ` : ''}
                            </div>
                        </div>

                        <div style="padding-left: 24px;">
                            <button onclick="openPatientCancelModal(${apt.appointmentId || apt.id})" 
                                style="padding: 10px 20px; border-radius: 12px; border: 1px solid #fee2e2; background: #fff; color: #ef4444; cursor: pointer; font-size: 13px; font-weight: 700; transition: all 0.2s; display: flex; align-items: center; gap: 8px;"
                                onmouseenter="this.style.background='#fef2f2'"
                                onmouseleave="this.style.background='#fff'">
                                ✗ Hủy lịch
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        fetchAppointments();

    page.expose({fetchAppointments, getStatusStyles, renderAppointments});
});
</script>
}
