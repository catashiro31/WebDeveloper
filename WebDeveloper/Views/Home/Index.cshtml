@{
    ViewData["Title"] = "Trang chủ";
    var topDoctors = ViewBag.TopDoctors as IEnumerable<WebDeveloper.Models.DTOs.Portal.DoctorCardResponse>;
    var specialties = ViewBag.Specialties as IEnumerable<WebDeveloper.Models.DTOs.Portal.SpecialtyResponse>;
    var facilities = ViewBag.Facilities as IEnumerable<WebDeveloper.Models.DTOs.Portal.FacilityResponse>;
    var stats = ViewBag.Stats as WebDeveloper.Models.DTOs.Portal.PortalStatsResponse;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    
    body { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; }

    .floating { animation: floating 6s ease-in-out infinite; }
    @@keyframes floating { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }

    .gradient-text {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.05);
    }

    .marquee-track { display: flex; width: max-content; animation: marquee 60s linear infinite; }
    @@keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    .service-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        background: #ffffff;
        border: 1px solid #f1f5f9;
    }
    .service-card:hover {
        transform: translateY(-8px);
        background: #ffffff;
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.08);
        border-color: #e2e8f0;
    }

    .btn-premium {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: white;
        box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.3);
    }
    .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -10px rgba(79, 70, 229, 0.4);
        filter: brightness(1.1);
        color: white;
    }
</style>

<div class="min-h-screen bg-white font-['Inter'] selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden">
    
    <!-- ===== HERO SECTION ===== -->
    <section class="relative pt-32 pb-20 overflow-hidden">
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-indigo-50/50 rounded-full blur-[150px] -z-10 translate-x-1/2 -translate-y-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-blue-50/50 rounded-full blur-[150px] -z-10 -translate-x-1/3 translate-y-1/3"></div>

        <div class="max-w-7xl mx-auto px-6 md:px-12 grid lg:grid-cols-2 gap-12 items-center">
            <div class="reveal space-y-10" style="animation-delay: 0.1s;">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 rounded-full">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                    </span>
                    <span class="text-indigo-600 font-bold text-[11px] uppercase tracking-wider">Hệ thống đặt lịch y tế #1 Việt Nam</span>
                </div>

                <h1 class="text-6xl md:text-7xl font-extrabold tracking-tighter leading-[1.05] gradient-text">
                    Kết nối sức khỏe <br />
                    <span class="text-indigo-600">toàn diện nhất</span>
                </h1>

                <p class="text-xl text-slate-500 leading-relaxed max-w-xl font-medium">
                    DocBooking giúp bạn tìm đúng bác sĩ, đúng chuyên khoa và đặt lịch khám chỉ trong vài thao tác. Tiết kiệm thời gian, nâng tầm trải nghiệm y tế số.
                </p>

                <div class="flex flex-wrap gap-5 pt-2">
                    <a href="@(isAuthenticated ? "/User/Profile" : "/Auth/Register")" class="btn-premium px-10 py-5 rounded-2xl font-bold text-lg flex items-center gap-3 decoration-none">
                        @(isAuthenticated ? "Đặt lịch ngay" : "Đăng ký ngay")
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pt-10 border-t border-slate-100">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 text-indigo-600 mb-1">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            <span class="text-2xl font-extrabold text-slate-900 tracking-tighter">@(stats?.TotalDoctors ?? 0)+</span>
                        </div>
                        <p class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Bác sĩ chuyên khoa</p>
                    </div>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 text-indigo-600 mb-1">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            <span class="text-2xl font-extrabold text-slate-900 tracking-tighter">@(stats?.TotalAppointments ?? 0)</span>
                        </div>
                        <p class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Lượt khám</p>
                    </div>
                </div>
            </div>

            <div class="relative reveal hidden lg:block" style="animation-delay: 0.3s;">
                <div class="absolute inset-0 bg-indigo-200/20 blur-[100px] rounded-full scale-150"></div>
                <div class="relative z-10 floating text-center">
                    <!-- Fake mockup avatar for now -->
                    <div style="width: 400px; height: 500px; background: linear-gradient(135deg, #e0e7ff, #c7d2fe); border-radius: 40px; margin: 0 auto; display: flex; align-items: center; justify-content: center; box-shadow: 0 40px 80px rgba(0,0,0,0.15);">
                        <svg width="150" height="150" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SPECIALTIES SECTION ===== -->
    <section class="py-24 bg-slate-50">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="flex flex-col items-center text-center mb-16 space-y-4 reveal">
                <span class="text-indigo-600 font-extrabold text-[12px] uppercase tracking-[0.3em]">Danh mục dịch vụ</span>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tighter">Chuyên khoa nổi bật</h2>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @if(specialties != null)
                {
                    foreach (var s in specialties.Take(8))
                    {
                        <a href="/Portal/Doctors?specId=@s.Id" class="service-card group p-8 rounded-[2rem] cursor-pointer block decoration-none text-slate-900">
                            <div class="mb-6 w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center group-hover:bg-indigo-600 transition-colors">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-600 group-hover:text-white transition-colors">
                                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                                </svg>
                            </div>
                            <h3 class="text-lg font-extrabold tracking-tight group-hover:text-indigo-600">@s.Name</h3>
                        </a>
                    }
                }
            </div>
        </div>
    </section>

    <!-- ===== PARTNER FACILITIES ===== -->
    <section class="py-12 bg-white border-y border-slate-100 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 md:px-12 mb-8">
            <p class="text-center text-sm font-bold text-slate-400 uppercase tracking-widest">Đồng hành cùng các cơ sở y tế uy tín</p>
        </div>
        <div class="relative w-full flex">
            <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
            <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
            <div class="marquee-track gap-6 px-4 hover:[animation-play-state:paused]">
                @if (facilities != null)
                {
                    // Repeat items for marquee
                    var items = facilities.Take(15).ToList();
                    items.AddRange(items);
                    items.AddRange(items);
                    
                    foreach(var fac in items)
                    {
                        <a href="/Portal/Facilities" class="flex items-center gap-4 bg-slate-50 border border-slate-100 px-8 py-4 rounded-2xl hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1 cursor-pointer transition-all shrink-0 decoration-none text-slate-700">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center font-black text-indigo-700 text-sm">
                                @(fac.Name?.Substring(0, 1) ?? "H")
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-base">@fac.Name</span>
                                @if(fac.Verified)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-[11px] font-bold text-emerald-700">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                                        Đã xác minh
                                    </span>
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </section>

    <!-- ===== TOP DOCTORS SECTION ===== -->
    <section class="py-24 max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16 px-2 reveal">
            <div class="space-y-4">
                <span class="text-indigo-600 font-extrabold text-[12px] uppercase tracking-[0.3em]">Bác sĩ xuất sắc</span>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tighter">Đội ngũ chuyên gia</h2>
            </div>
            <a href="/Portal/Doctors" class="btn-premium px-8 py-3 rounded-xl font-bold text-sm decoration-none">
                Xem tất cả chuyên gia
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            @if(topDoctors != null)
            {
                foreach(var doc in topDoctors)
                {
                    <a href="/Portal/DoctorDetail?id=@doc.DoctorId" class="group relative bg-white rounded-[2.5rem] overflow-hidden border border-slate-100 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 cursor-pointer flex flex-col h-full decoration-none text-slate-900 block">
                        <div class="aspect-[3/4] bg-slate-50 overflow-hidden shrink-0 relative">
                            @if(!string.IsNullOrEmpty(doc.AvatarUrl))
                            {
                                <img src="@doc.AvatarUrl" alt="@doc.DoctorName" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            }
                            <div style="display: @(!string.IsNullOrEmpty(doc.AvatarUrl) ? "none" : "flex"); width: 100%; height: 100%; background: linear-gradient(135deg, #f8fafc, #e2e8f0); align-items: center; justify-content: center; color: #6366f1; font-weight: 900; font-size: 32px;">
                                @(doc.DoctorName?.Substring(0, Math.Min(2, doc.DoctorName.Length)).ToUpper() ?? "DR")
                            </div>

                            <div class="absolute top-6 left-6">
                                <span class="px-4 py-2 bg-white/90 backdrop-blur-md rounded-xl text-[10px] font-black uppercase tracking-widest text-indigo-600 shadow-sm border border-white/50">
                                    @doc.SpecialtyName
                                </span>
                            </div>
                        </div>
                        <div class="p-8 flex flex-col flex-1">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-1.5 px-2 py-1 bg-amber-50 text-amber-600 rounded-lg text-xs font-bold shrink-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#d97706" stroke="#d97706" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    @((doc.RatingAverage ?? 5.0).ToString("0.0"))
                                </div>
                            </div>
                            <h3 class="text-xl font-extrabold tracking-tight group-hover:text-indigo-600 transition-colors mb-4 line-clamp-2">BS. @doc.DoctorName</h3>
                            <button class="mt-auto w-full py-4 bg-slate-50 border-none cursor-pointer rounded-2xl text-slate-900 font-bold text-sm group-hover:bg-indigo-600 group-hover:text-white transition-all shrink-0">
                                Đặt lịch khám ngay
                            </button>
                        </div>
                    </a>
                }
            }
        </div>
    </section>

    <!-- ===== FEATURES SECTION ===== -->
    <section class="py-24 bg-slate-950 rounded-[4rem] mx-6 md:mx-12 mb-24 overflow-hidden relative">
        <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(circle_at_top_right,rgba(99,102,241,0.1),transparent)]"></div>
        <div class="max-w-7xl mx-auto px-6 md:px-12 grid lg:grid-cols-2 gap-20 items-center relative z-10">
            <div class="space-y-8">
                <span class="text-indigo-400 font-extrabold text-[12px] uppercase tracking-[0.4em]">Trải nghiệm số</span>
                <h2 class="text-5xl md:text-6xl font-extrabold text-white tracking-tighter leading-tight">
                    Quản lý y tế <br />
                    <span class="text-indigo-400 underline decoration-indigo-400/30 underline-offset-8">Gia đình tập trung</span>
                </h2>
                <p class="text-indigo-100/60 text-lg font-medium leading-relaxed max-w-lg">
                    Không còn lo lắng việc lưu trữ hồ sơ giấy. Với DocBooking, bạn quản lý toàn bộ quá trình khám chữa bệnh cho con cái và người thân trên một tài khoản duy nhất.
                </p>
                <div class="space-y-4">
                    <div class="flex gap-4 p-6 bg-white/5 border border-white/10 rounded-[2rem] hover:bg-white/10 transition-colors">
                        <div class="mt-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        </div>
                        <div>
                            <h4 class="text-white font-bold m-0">Bảo mật HIPAA</h4>
                            <p class="text-indigo-100/40 text-sm m-0 mt-1">Dữ liệu y tế được mã hóa an toàn tuyệt đối.</p>
                        </div>
                    </div>
                    <div class="flex gap-4 p-6 bg-white/5 border border-white/10 rounded-[2rem] hover:bg-white/10 transition-colors">
                        <div class="mt-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        </div>
                        <div>
                            <h4 class="text-white font-bold m-0">Thông báo nhắc lịch</h4>
                            <p class="text-indigo-100/40 text-sm m-0 mt-1">Tự động gửi SMS/Email nhắc lịch hẹn khám.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hidden lg:block relative">
                <div class="absolute inset-0 bg-indigo-500/20 blur-[120px] rounded-full scale-110"></div>
                <div class="relative z-10 floating flex justify-center">
                   <!-- Fake Mockup box -->
                   <div style="width: 300px; height: 450px; background: white; border-radius: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); border: 8px solid #1e293b; display:flex; flex-direction: column;">
                       <div style="height: 60px; background: #4f46e5; border-radius: 20px 20px 0 0; display:flex; align-items:center; padding-left: 20px; color: white; font-weight: bold;">DocBooking App</div>
                       <div style="flex:1; padding: 20px;">
                           <div style="width: 100%; height: 60px; background: #f1f5f9; border-radius: 10px; margin-bottom: 10px;"></div>
                           <div style="width: 100%; height: 60px; background: #f1f5f9; border-radius: 10px; margin-bottom: 10px;"></div>
                           <div style="width: 100%; height: 60px; background: #f1f5f9; border-radius: 10px;"></div>
                       </div>
                   </div>
                </div>
            </div>
        </div>
    </section>

</div>
