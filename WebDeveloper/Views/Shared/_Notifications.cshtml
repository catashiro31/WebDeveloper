@if (User.Identity?.IsAuthenticated == true)
{
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <div id="notificationCenter">
        <button id="notificationBell" type="button" aria-label="Thông báo" aria-expanded="false" aria-controls="notificationPanel">🔔<span id="notificationBadge" hidden></span></button>
        <section id="notificationPanel" hidden aria-label="Hộp thông báo">
            <div class="notification-toolbar"><strong>Thông báo</strong><button id="notificationClose" type="button" aria-label="Đóng thông báo">×</button></div>
            <div class="notification-actions">
                <button id="notificationReadAll" type="button">Đánh dấu tất cả đã đọc</button>
                <button id="notificationDeleteRead" type="button">Xóa thông báo đã đọc</button>
            </div>
            <p class="notification-help">Bấm một lần để đánh dấu đã đọc. Bấm đúp để mở trang liên quan.</p>
            <p id="notificationStatus" role="status"></p>
            <div id="notificationList"></div>
            <button id="notificationMore" type="button" hidden>Xem thêm</button>
            <button id="notificationRetry" type="button" hidden>Thử lại</button>
        </section>

        <!-- Modal xác nhận thao tác thông báo -->
        <div id="notificationConfirmModal" class="notification-modal-overlay" hidden>
            <div class="notification-modal-card" role="dialog" aria-modal="true" aria-labelledby="notifModalTitle" onclick="event.stopPropagation()">
                <div id="notifModalIcon" class="notification-modal-icon"></div>
                <h4 id="notifModalTitle" class="notification-modal-title"></h4>
                <p id="notifModalDesc" class="notification-modal-desc"></p>
                <div class="notification-modal-actions">
                    <button type="button" id="notifModalCancel" class="btn-notif-cancel">Hủy</button>
                    <button type="button" id="notifModalConfirm" class="btn-notif-confirm">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
}
