@if (Context.Request.Headers["X-Workspace-Navigation"] == "1")
{
    Context.Response.Headers.CacheControl = "no-store";
    <template data-workspace-fragment="Patient" data-title="@ViewData["Title"] - DocBooking">@RenderBody()</template>
    <template data-workspace-styles>@await RenderSectionAsync("Styles", required: false)</template>
    <template data-workspace-scripts>@await RenderSectionAsync("Scripts", required: false)</template>
    return;
}
@{
    Layout = null;
    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Bệnh nhân";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var userAvatar = User.FindFirst("AvatarUrl")?.Value ?? "";

    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString()?.ToLower();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <meta charset="utf-8" />
    <script src="/js/workspace-navigation.js" asp-append-version="true"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocBooking</title>
    <link rel="stylesheet" href="/css/utilities.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="/lib/toastify/toastify.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/api-feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/role-layout.css" asp-append-version="true" />
    <style>
        body { font-family: var(--font-app); background: #f8fafc; margin: 0; }
        .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .premium-card { background: white; border-radius: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: 1px solid rgba(226, 232, 240, 0.8); }
        .reveal { animation: reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .reveal-delayed { animation: reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards; opacity: 0; }
        @@keyframes reveal {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .nav-btn {
            display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px;
            border: none; background: transparent; color: #475569; cursor: pointer;
            font-size: 14px; font-weight: 600; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-align: left; text-decoration: none; width: 100%; box-sizing: border-box;
        }
        .nav-btn:hover { background: #f1f5f9; }
        .nav-btn.active {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white; font-weight: 700;
            box-shadow: 0 8px 15px rgba(99, 102, 241, 0.25);
        }
    </style>
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="/css/responsive.css" asp-append-version="true" />
    <script src="/js/responsive.js" asp-append-version="true" defer></script>
</head>
<body data-workspace="Patient">
    <!-- Shade overlay -->
    <button id="workspaceShade" type="button" aria-label="Đóng menu"></button>
    <div id="workspaceLoading" class="workspace-loading" role="status" hidden>
        <span class="workspace-spinner" aria-hidden="true"></span><span>Đang tải trang…</span>
    </div>
    <div id="workspaceError" role="alert" hidden></div>
    <!-- Header -->
    <header class="glass role-header" style="position: sticky; top: 0; z-index: 100; padding: 12px 40px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); gap: 12px;">
        @* Hamburger — shown only on ≤1024px via CSS *@
        <button id="workspaceMenu" class="workspace-menu" type="button" aria-controls="workspaceSidebar" aria-expanded="false" aria-label="Mở menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div style="display: flex; align-items: center; gap: 20px; flex: 1;">
            <a href="/" style="text-decoration: none;">
                <h1 style="margin: 0; font-size: 24px; font-weight: 900; background: linear-gradient(135deg, #6366f1, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.03em;">
                    DocBooking
                </h1>
            </a>
        </div>

        <div class="role-header-actions" style="display: flex; align-items: center; gap: 14px;">
            <a href="/" class="role-nav-link" style="display: flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 10px; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.15); color: #4f46e5; font-weight: 700; font-size: 13px; text-decoration: none; transition: all 0.2s;">
                🏠 Trang chủ
            </a>
            <a href="/Portal/Doctors" class="role-nav-link" style="color: #6366f1; text-decoration: none; font-weight: 600; font-size: 14px;">
                🏥 Tìm bác sĩ
            </a>
            <div class="role-user-pill" style="display: flex; align-items: center; gap: 10px; padding: 6px 14px; background: rgba(99, 102, 241, 0.05); border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.1);">
                <span id="patientHeaderName" class="role-user-name" style="font-weight: 600; font-size: 14px; color: #1e293b;">@userName</span>
                <button onclick="logout()" class="role-logout-btn" style="padding: 6px 12px; border-radius: 8px; border: none; background: #ef4444; color: white; cursor: pointer; font-size: 12px; font-weight: 700; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);">
                    Đăng xuất
                </button>
            </div>
        </div>
    </header>

    <div class="role-shell" style="display: flex; max-width: 1440px; margin: 0 auto; padding: 32px 40px; gap: 32px;">
        <!-- Sidebar -->
        <aside id="workspaceSidebar" class="reveal" style="width: 280px; flex-shrink: 0;">
            <div class="premium-card" style="padding: 24px; position: sticky; top: 100px;">
                <div style="margin-bottom: 28px; text-align: center;">
                    <div id="patientSidebarAvatar" style="width: 72px; height: 72px; border-radius: 24px; background: @(!string.IsNullOrEmpty(userAvatar) ? $"url('{userAvatar}') center/cover" : "linear-gradient(135deg, #6366f1, #8b5cf6)"); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 28px; color: white; box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3); overflow: hidden;">
                        @if (string.IsNullOrEmpty(userAvatar))
                        {
                            @(string.IsNullOrEmpty(userName) ? "👤" : userName.Substring(0, 1).ToUpper())
                        }
                    </div>
                    <h3 id="patientSidebarName" style="margin: 0 0 4px; font-size: 18px; font-weight: 800;">@userName</h3>
                    <p style="margin: 0; color: #64748b; font-size: 13px; font-weight: 500;">@userEmail</p>
                </div>

                <nav style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="/Patient/Appointments" class="nav-btn @(currentAction == "appointments" || currentAction == "index" ? "active" : "")">
                        <span style="font-size: 18px;">📅</span>
                        <span>Lịch hẹn</span>
                    </a>
                    <a href="/Patient/History" class="nav-btn @(currentAction == "history" ? "active" : "")">
                        <span style="font-size: 18px;">📋</span>
                        <span>Lịch sử khám</span>
                    </a>
                    <a href="/Patient/Relatives" class="nav-btn @(currentAction == "relatives" ? "active" : "")">
                        <span style="font-size: 18px;">👨‍👩‍👧‍👦</span>
                        <span>Hồ sơ người thân</span>
                    </a>
                </nav>

                <div style="margin: 24px 0; height: 1px; background: #f1f5f9;"></div>

                <nav style="display: flex; flex-direction: column; gap: 8px;">
                    <a href="/Patient/Profile" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 10px; color: #64748b; text-decoration: none; font-size: 14px; font-weight: 600; transition: color 0.2s;">
                        <span>⚙️</span>
                        <span>Cài đặt tài khoản</span>
                    </a>
                    <a href="/Patient/ChangePassword" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 10px; color: #64748b; text-decoration: none; font-size: 14px; font-weight: 600; transition: color 0.2s;">
                        <span>🔐</span>
                        <span>Đổi mật khẩu</span>
                    </a>
                </nav>

                <div class="sidebar-mobile-only" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #f1f5f9; display: flex; flex-direction: column; gap: 8px;">
                    <a href="/" style="display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: 10px; color: #4338ca; background: #eef2ff; text-decoration: none; font-size: 13.5px; font-weight: 700;">
                        <span>🏠</span>
                        <span>Về trang chủ</span>
                    </a>
                    <a href="/Portal/Doctors" style="display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: 10px; color: #4f46e5; background: #f5f3ff; text-decoration: none; font-size: 13.5px; font-weight: 700;">
                        <span>🏥</span>
                        <span>Tìm bác sĩ</span>
                    </a>
                    <button type="button" onclick="logout()" style="display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 16px; border-radius: 10px; border: none; background: #fee2e2; color: #dc2626; font-size: 14px; font-weight: 700; cursor: pointer; text-align: left; margin-top: 4px;">
                        <span>🚪</span>
                        <span>Đăng xuất</span>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="reveal-delayed" style="flex: 1;">
            <div class="premium-card role-content-card" style="padding: 32px; min-height: 600px;">
                <div id="workspaceContent" tabindex="-1">@RenderBody()</div>
            </div>
        </main>
    </div>

    <script src="/lib/toastify/toastify.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_AuthState")
    <script src="/js/auth-logout.js" asp-append-version="true"></script>
    <script src="/js/api-messages.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
    @await Html.PartialAsync("_Notifications")
</body>
</html>
