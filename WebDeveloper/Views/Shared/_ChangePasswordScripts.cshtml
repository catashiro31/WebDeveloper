<script>
DocBookingPage.mount(page => {
    const { fetch, fetchApiList, setTimeout, setInterval, clearTimeout, clearInterval } = page;

        const eyeOpenSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
        const eyeCloseSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;

        page.globals.togglePassword = function(id, btn) {
            const input = document.getElementById(id);
            if (!input) return;
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.innerHTML = isText ? eyeOpenSvg : eyeCloseSvg;
        };

        page.globals.checkPasswordStrength = function() {
            const pwd = document.getElementById('newPassword').value;
            const bar = document.getElementById('pwdStrengthBar');
            const label = document.getElementById('pwdStrengthLabel');
            const ruleLength = document.getElementById('ruleLength');
            const ruleUpper = document.getElementById('ruleUpper');
            const ruleLower = document.getElementById('ruleLower');
            const ruleNumber = document.getElementById('ruleNumber');
            
            if (!pwd) {
                bar.style.width = '0%';
                bar.style.background = '#e2e8f0';
                label.textContent = 'Chưa nhập';
                label.style.color = '#94a3b8';
                updateRule(ruleLength, false);
                updateRule(ruleUpper, false);
                updateRule(ruleLower, false);
                updateRule(ruleNumber, false);
                return;
            }

            const hasLength = pwd.length >= 6;
            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasNumber = /\d/.test(pwd);

            updateRule(ruleLength, hasLength);
            updateRule(ruleUpper, hasUpper);
            updateRule(ruleLower, hasLower);
            updateRule(ruleNumber, hasNumber);

            let score = 0;
            if (hasLength) score += 1;
            if (hasUpper) score += 1;
            if (hasLower) score += 1;
            if (hasNumber) score += 1;
            if (pwd.length >= 10) score += 1;

            if (score <= 2) {
                bar.style.width = '33%';
                bar.style.background = '#ef4444';
                label.textContent = 'Yếu';
                label.style.color = '#ef4444';
            } else if (score <= 4) {
                bar.style.width = '66%';
                bar.style.background = '#f59e0b';
                label.textContent = 'Trung bình';
                label.style.color = '#f59e0b';
            } else {
                bar.style.width = '100%';
                bar.style.background = '#10b981';
                label.textContent = 'Mạnh';
                label.style.color = '#10b981';
            }

            checkPasswordMatch();
        };

        function updateRule(elem, isValid) {
            if (!elem) return;
            if (isValid) {
                elem.classList.add('valid');
                const icon = elem.querySelector('.pwd-rule-icon');
                if (icon) icon.textContent = '✓';
            } else {
                elem.classList.remove('valid');
                const icon = elem.querySelector('.pwd-rule-icon');
                if (icon) icon.textContent = '○';
            }
        }

        page.globals.checkPasswordMatch = function() {
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const hint = document.getElementById('pwdMatchHint');

            if (!confirmPwd) {
                hint.style.display = 'none';
                return;
            }

            hint.style.display = 'block';
            if (newPwd === confirmPwd) {
                hint.textContent = '✓ Mật khẩu xác nhận trùng khớp';
                hint.style.color = '#16a34a';
            } else {
                hint.textContent = '✕ Mật khẩu xác nhận chưa khớp';
                hint.style.color = '#dc2626';
            }
        };

        function showMessage(text, type) {
            const box = document.getElementById('messageBox');
            box.style.display = 'block';
            box.innerText = text;
            if (type === 'success') {
                box.style.background = '#ecfdf5';
                box.style.color = '#059669';
                box.style.border = '1px solid #a7f3d0';
            } else {
                box.style.background = '#fef2f2';
                box.style.color = '#dc2626';
                box.style.border = '1px solid #fecaca';
            }
        }

        page.globals.handleSubmit = function(e) {
            e.preventDefault();
            
            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (window.Validation) {
                const passCheck = window.Validation.validatePassword(newPassword);
                if (!passCheck.valid) {
                    showMessage(passCheck.message, "error");
                    return;
                }
            } else if (newPassword.length < 6) {
                showMessage("Mật khẩu phải có ít nhất 6 ký tự!", "error");
                return;
            }

            if (newPassword !== confirmPassword) {
                showMessage("Mật khẩu mới không khớp!", "error");
                return;
            }

            const currentAuthToken = localStorage.getItem('token');
            if (!currentAuthToken) {
                window.location.href = '/Auth/Login';
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = 'Đang cập nhật...';
            btn.style.opacity = '0.7';
            document.getElementById('messageBox').style.display = 'none';

            fetch('/api/v1/user/password', {
                method: 'PUT',
                headers: { 
                    'Authorization': `Bearer ${currentAuthToken}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ oldPassword, newPassword })
            })
            .then(async res => {
                if (res.ok) {
                    showMessage("Đổi mật khẩu thành công!", "success");
                    document.getElementById('oldPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';
                    checkPasswordStrength();
                    checkPasswordMatch();
                } else {
                    const msg = (typeof readApiMessage === 'function') ? await readApiMessage(res) : null;
                    showMessage(msg || "Mật khẩu cũ không chính xác hoặc có lỗi xảy ra", "error");
                }
            })
            .catch(() => showMessage("Đã xảy ra lỗi khi kết nối máy chủ", "error"))
            .finally(() => {
                btn.disabled = false;
                btn.innerText = 'Cập nhật mật khẩu';
                btn.style.opacity = '1';
            });
        };

    page.expose({updateRule, showMessage});
});
</script>
