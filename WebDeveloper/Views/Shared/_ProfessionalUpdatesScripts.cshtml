<script>
DocBookingPage.mount(page => {
    const root = document.getElementById('professionalPage');
    const admin = root.dataset.admin === 'true';
    const el = id => root.querySelector('#' + id);
    const api = '/api/v1/' + (admin ? 'admin' : 'doctor') + '/professional-updates';
    let current = null, pageIndex = 0, currentVersion = 0, historyVersion = 0;
    const doctorId = () => admin ? el('proDoctor').value : current?.doctorId;
    const message = (text, error = false) => { el('proMessage').textContent = text; el('proMessage').style.color = error ? '#be123c' : '#047857'; };
    const date = value => value ? new Date(value).toLocaleString('vi-VN', { timeZone:'Asia/Ho_Chi_Minh' }) : 'Chưa xử lý';
    const money = value => value == null ? 'Chưa có thông tin' : Number(value).toLocaleString('vi-VN') + ' đ';
    function safeLink(url, label) {
        if (!url) return 'Chưa có tệp';
        try { const u = new URL(url); if (!['https:', 'http:'].includes(u.protocol)) return 'Đường dẫn không hợp lệ'; }
        catch (_) { return 'Đường dẫn không hợp lệ'; }
        return `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(label)}</a>`;
    }
    async function json(url, options) {
        const response = await page.fetch(url, options);
        if (!response.ok) throw new Error(await readApiMessage(response));
        return response.json();
    }
    function otherDegree() { el('proOtherWrap').hidden = el('proDegree').value !== 'Khác'; }
    el('proDegree').onchange = otherDegree;
    async function loadCurrent() {
        const version = ++currentVersion;
        current = null; el('proFields').disabled = true;
        const selected = admin ? el('proDoctor').value : '';
        if (admin && !selected) { el('proEditor').hidden = true; return; }
        el('proEditor').hidden = false; el('proCurrent').textContent = 'Đang tải hồ sơ…';
        try {
            const data = await json(admin ? api + '/doctors/' + selected : api + '/current');
            const specialties = await json('/api/v1/portal/specialties');
            if (version !== currentVersion) return;
            current = data; const p = data.currentProfile;
            el('proForm').reset();
            el('proCurrent').innerHTML = `<strong>${escapeHtml(data.doctorName)}</strong><p>${escapeHtml(p.degree || 'Chưa cập nhật học vị')} · ${escapeHtml(p.specialtyName)}</p><p>Năm bắt đầu: ${p.practiceStartYear ?? 'Chưa có thông tin'}${p.practiceStartYear == null && p.legacyExperienceYears != null ? ' (hồ sơ cũ ghi ' + Number(p.legacyExperienceYears) + ' năm kinh nghiệm)' : ''}</p><p>Chứng chỉ: ${safeLink(p.certificateUrl, 'Xem chứng chỉ hiện có')} · CCCD: ${safeLink(data.idCardUrl, 'Xem CCCD')}</p><p>Giá hiện tại: ${money(p.price)}. Giá mới chỉ áp dụng cho lịch đặt mới.</p>`;
            const options = [...el('proDegree').options].map(o => o.value);
            if (!p.degree) el('proDegree').value = '';
            else if (options.includes(p.degree)) el('proDegree').value = p.degree;
            else { el('proDegree').value = 'Khác'; el('proDegreeOther').value = (p.degree || '').replace(/^Khác:\s*/, ''); }
            otherDegree(); el('proYear').value = p.practiceStartYear ?? '';
            const select = el('proSpecialty'); select.replaceChildren();
            for (const s of specialties) select.add(new Option(s.name, s.id));
            if (!specialties.some(s => s.id === p.specialtyId)) select.add(new Option(p.specialtyName + ' (ngừng hoạt động)', p.specialtyId));
            select.value = p.specialtyId;
            el('proExisting').disabled = !p.certificateUrl;
            if (admin) { el('proPrice').value = p.price ?? ''; el('proBio').value = p.bio ?? ''; }
            const allowed = admin || (data.verificationStatus === 'APPROVED' && !data.hasPending);
            el('proFields').disabled = !allowed;
            el('proEligibility').textContent = (data.hasPending ? 'Đang có yêu cầu chờ duyệt. ' : '') +
                (data.activeAppointments ? `Còn ${data.activeAppointments} lịch chưa xử lý; chưa thể áp dụng chuyển chuyên khoa. ` : '') +
                (!admin && data.verificationStatus !== 'APPROVED' ? 'Hãy hoàn tất xét duyệt hồ sơ ban đầu trước khi gửi cập nhật.' : '');
            el('proRetry').hidden = true;
        } catch (error) { if (version === currentVersion) { message(error.message, true); el('proCurrent').textContent = 'Không thể tải hồ sơ.'; el('proRetry').hidden = false; } }
    }
    function comparison(item) {
        const rows = [['degree','Học vị / bằng cấp'],['practiceStartYear','Năm bắt đầu hành nghề'],['specialtyName','Chuyên khoa'],['certificateUrl','Chứng chỉ hành nghề']];
        if (item.before.price !== item.proposed.price) rows.push(['price','Giá khám cho lịch mới']);
        if (item.before.bio !== item.proposed.bio) rows.push(['bio','Giới thiệu']);
        const value = (p, key) => key === 'certificateUrl' ? safeLink(p[key], 'Xem tệp') : key === 'price' ? money(p[key]) : escapeHtml(p[key] ?? 'Chưa có thông tin');
        return `<table class="pro-compare"><thead><tr><th>Thông tin</th><th>Trước thay đổi</th><th>Đề nghị mới</th></tr></thead><tbody>${rows.map(([key,label]) => `<tr><td>${label}</td><td>${value(item.before,key)}</td><td${item.before[key] !== item.proposed[key] ? ' style="background:#eef2ff;font-weight:600"' : ''}>${value(item.proposed,key)}</td></tr>`).join('')}</tbody></table>`;
    }
    async function loadHistory() {
        const version = ++historyVersion;
        el('proHistory').textContent = 'Đang tải…'; el('proPagination').replaceChildren();
        const params = new URLSearchParams({ page:pageIndex, size:10 });
        if (admin) { if (doctorId()) params.set('doctorId',doctorId()); if (el('proStatus').value) params.set('status',el('proStatus').value); }
        try {
            const data = await json(api + '?' + params);
            if (version !== historyVersion) return;
            if (data.totalPages > 0 && pageIndex >= data.totalPages) { pageIndex = data.totalPages - 1; return loadHistory(); }
            el('proHistory').replaceChildren();
            if (!data.content.length) el('proHistory').textContent = 'Không có yêu cầu trong danh sách này.';
            for (const item of data.content) {
                const card = document.createElement('details'); card.className = 'pro-card'; card.dataset.requestId = item.id;
                const label = item.status === 'PENDING' ? 'Chờ duyệt' : item.status === 'REJECTED' ? 'Đã từ chối' : item.appliedDirectly ? 'Admin chỉnh trực tiếp' : 'Đã duyệt';
                card.innerHTML = `<summary>${escapeHtml(item.doctorName)} — <span class="pro-status">${label}</span> · ${date(item.createdAt)}</summary>${comparison(item)}<p><strong>Lý do:</strong> ${escapeHtml(item.reason)}</p><p>Minh chứng: ${safeLink(item.evidenceUrl,'Xem minh chứng')}</p><p class="pro-note">Người gửi: ${escapeHtml(item.submittedBy)} · Người xử lý: ${escapeHtml(item.reviewedBy || 'Chưa xử lý')} · ${date(item.reviewedAt)}</p>${item.decisionReason ? `<p><strong>Phản hồi:</strong> ${escapeHtml(item.decisionReason)}</p>` : ''}`;
                if (admin && item.status === 'PENDING') {
                    const note = document.createElement('textarea'); note.placeholder = 'Ghi chú duyệt hoặc lý do từ chối (bắt buộc khi từ chối)'; note.maxLength = 1000; note.setAttribute('aria-label','Phản hồi yêu cầu ' + item.id); card.append(note);
                    const actions = document.createElement('div'); actions.className = 'pro-actions';
                    for (const approve of [true,false]) {
                        const button = document.createElement('button'); button.type = 'button'; button.textContent = approve ? 'Duyệt yêu cầu' : 'Từ chối'; button.className = approve ? 'primary' : 'danger';
                        button.onclick = async () => {
                            if (!approve && note.value.trim().length < 3) { message('Vui lòng nhập lý do từ chối ít nhất 3 ký tự.',true); note.focus(); return; }
                            actions.querySelectorAll('button').forEach(b => b.disabled = true);
                            try { const result = await json(api + '/' + item.id, {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({approve,reason:note.value.trim()})}); message(result.message); await Promise.all([loadCurrent(),loadHistory()]); }
                            catch (error) { message(error.message,true); actions.querySelectorAll('button').forEach(b => b.disabled = false); }
                        }; actions.append(button);
                    }
                    card.append(actions);
                }
                el('proHistory').append(card);
            }
            if (data.totalPages > 1) {
                for (const [label,target] of [['Trước',pageIndex-1],['Sau',pageIndex+1]]) { const b=document.createElement('button'); b.textContent=label; b.disabled=target<0||target>=data.totalPages; b.onclick=()=>{pageIndex=target;loadHistory();}; el('proPagination').append(b); }
                el('proPagination').append(document.createTextNode(` Trang ${pageIndex+1}/${data.totalPages} · ${data.totalElements} bản ghi`));
            }
        } catch(error) { if(version===historyVersion) { el('proHistory').textContent='Không thể tải lịch sử.';message(error.message,true);el('proRetry').hidden=false; } }
    }
    el('proForm').onsubmit = async event => {
        event.preventDefault(); if (!current) return;
        for (const id of ['proEvidence','proCertificate']) { const file=el(id).files[0]; if(file && (file.size>5*1024*1024 || !['application/pdf','image/jpeg','image/png'].includes(file.type))) { message('Tệp phải là PDF, JPG hoặc PNG và không quá 5 MB.',true);return; } }
        const form = new FormData(el('proForm'));
        for (const [key,value] of [...form]) if ((typeof value === 'string' && value === '') || (value instanceof File && !value.size)) form.delete(key);
        if (el('proDegree').value) {
            const other = el('proDegreeOther').value.trim();
            const previous = current.currentProfile.degree || '';
            const degree = el('proDegree').value === 'Khác'
                ? (other === previous.replace(/^Khác:\s*/, '') ? previous : 'Khác: ' + other)
                : el('proDegree').value;
            form.set('degree',degree);
        } else form.delete('degree');
        form.set('expectedVersion',current.version);
        const endpoint = admin ? api+'/doctors/'+current.doctorId : api;
        el('proFields').disabled = true; if(admin)el('proDoctor').disabled=true;
        try { const result=await json(endpoint,{method:'POST',body:form});message(result.message);if(admin)el('proStatus').value='';pageIndex=0;await Promise.all([loadCurrent(),loadHistory()]); }
        catch(error){message(error.message,true);el('proFields').disabled=false;}
        finally { if(admin)el('proDoctor').disabled=false; }
    };
    async function init() {
        try {
            if(admin){const doctors=await json(api+'/doctors');const select=el('proDoctor');const chosen=select.value||new URLSearchParams(location.search).get('doctorId')||'';select.replaceChildren(new Option('Tất cả bác sĩ — danh sách yêu cầu',''));doctors.forEach(d=>select.add(new Option(d.name,d.id)));select.value=chosen;}
            await Promise.all([loadCurrent(),loadHistory()]);
        }catch(error){message(error.message,true);el('proRetry').hidden=false;}
    }
    el('proRetry').onclick=init;
    if(admin){el('proDoctor').onchange=()=>{pageIndex=0;loadCurrent();loadHistory();};el('proStatus').onchange=()=>{pageIndex=0;loadHistory();};}
    init();
});
</script>
