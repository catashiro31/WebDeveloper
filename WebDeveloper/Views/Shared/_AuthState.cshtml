@using System.Security.Claims
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@inject WebDeveloper.Data.ApplicationDbContext Db
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    WebDeveloper.Models.Entities.User? account = null;
    string? verificationStatus = null;
    if (signedIn && int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId))
    {
        account = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.UserId == userId);
        if (User.IsInRole("DOCTOR"))
        {
            var doctor = await Db.DoctorDetails.AsNoTracking().FirstOrDefaultAsync(d => d.UserId == userId);
            verificationStatus = doctor?.VerificationStatus.ToString() ?? "UNREGISTERED";
        }
    }
    var browserUser = JsonSerializer.Serialize(new
    {
        email = User.FindFirst(ClaimTypes.Email)?.Value ?? "",
        fullName = account?.FullName ?? User.FindFirst(ClaimTypes.Name)?.Value ?? "",
        role = User.FindFirst(ClaimTypes.Role)?.Value ?? "",
        avatarUrl = account?.AvatarUrl ?? User.FindFirst("AvatarUrl")?.Value,
        phoneNumber = account?.PhoneNumber,
        verificationStatus
    });
}
<script>
    // Keep legacy view scripts in sync with the server-validated cookie session.
    // This value is only a UI marker; the actual JWT stays in an HttpOnly cookie.
    try {
        if (@(signedIn ? "true" : "false")) {
            localStorage.setItem('token', 'SECURE_HTTPONLY_COOKIE');
            localStorage.setItem('user', @Html.Raw(JsonSerializer.Serialize(browserUser)));
        } else {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
        }
    } catch (_) {
        // Storage can be unavailable; server authorization remains authoritative.
    }
</script>
