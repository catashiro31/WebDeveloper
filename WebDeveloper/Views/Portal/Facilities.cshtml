@{
    ViewData["Title"] = "Cơ sở y tế";
}

<style>
.facilities-page {
    min-height: 100vh;
    background: #f8fafc;
    font-family: 'Inter', sans-serif;
    padding-top: 120px;
    padding-bottom: 80px;
    padding-left: 20px;
    padding-right: 20px;
}

.facilities-container {
    max-width: 1200px;
    margin: 0 auto;
}

.facilities-header {
    text-align: center;
    margin-bottom: 48px;
}

.facilities-header h1 {
    font-size: 36px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 16px;
}

.facilities-header p {
    font-size: 16px;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
}

.loading-state, .empty-state {
    text-align: center;
    padding: 40px;
    color: #64748b;
}

.empty-state {
    background: white;
    border-radius: 16px;
}

.facilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
}

.facility-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: transform 0.2s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
}

.facility-card:hover {
    transform: translateY(-4px);
}

.facility-img-wrap {
    height: 200px;
    background: #f1f5f9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.facility-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.facility-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.facility-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.facility-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 8px;
}

.facility-title-row h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
}

.verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    font-size: 12px;
    font-weight: 700;
}

.facility-address {
    margin: 0 0 16px;
    font-size: 14px;
    color: #64748b;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}

.facility-desc {
    margin: 0 0 16px;
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 67px;
}

.map-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    margin-top: auto;
    width: fit-content;
}

.map-btn:hover {
    background: #e0e7ff;
    color: #4338ca;
}
</style>

<div class="facilities-page">
    <div class="facilities-container">
        <div class="facilities-header">
            <h1>Cơ sở y tế liên kết</h1>
            <p>Khám phá mạng lưới các bệnh viện và phòng khám uy tín đối tác của DocBooking, mang đến cho bạn dịch vụ chăm sóc sức khỏe tốt nhất.</p>
        </div>

        <div id="facilitiesContainer">
            <div class="loading-state">Đang tải danh sách cơ sở y tế...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('facilitiesContainer');
            
            fetch('/api/v1/portal/facilities')
                .then(res => res.json())
                .then(data => {
                    const list = data.content || data || [];
                    const facilities = Array.isArray(list) ? list : [];
                    
                    if (facilities.length === 0) {
                        container.innerHTML = `<div class="empty-state">Chưa có cơ sở y tế nào trong hệ thống.</div>`;
                        return;
                    }

                    let html = `<div class="facilities-grid">`;
                    facilities.forEach(fac => {
                        const hasImage = fac.imageUrl && fac.imageUrl.trim() !== '';
                        const name = fac.facilityName || fac.name;
                        const address = `${fac.address || ''}${fac.province ? `, ${fac.province}` : ''}`;
                        const verifiedHtml = fac.verified ? `
                            <span class="verified-badge">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                                Đã xác minh
                            </span>
                        ` : '';

                        const imgHtml = hasImage ? `
                            <img src="${fac.imageUrl}" alt="${name}" class="facility-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="facility-fallback" style="display: none;">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="2" width="16" height="20" rx="3" fill="#6366f1" fill-opacity="0.1"/><rect x="4" y="2" width="16" height="20" rx="3" stroke="#6366f1" stroke-width="2" stroke-dasharray="4 2"/><rect x="8" y="7" width="8" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><rect x="8" y="11" width="8" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><rect x="8" y="15" width="4" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><circle cx="18" cy="18" r="5" fill="#6366f1"/><path d="M18 15.5V20.5M15.5 18H20.5" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                            </div>
                        ` : `
                            <div class="facility-fallback">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="2" width="16" height="20" rx="3" fill="#6366f1" fill-opacity="0.1"/><rect x="4" y="2" width="16" height="20" rx="3" stroke="#6366f1" stroke-width="2" stroke-dasharray="4 2"/><rect x="8" y="7" width="8" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><rect x="8" y="11" width="8" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><rect x="8" y="15" width="4" height="2" rx="1" fill="#6366f1" fill-opacity="0.2"/><circle cx="18" cy="18" r="5" fill="#6366f1"/><path d="M18 15.5V20.5M15.5 18H20.5" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                            </div>
                        `;

                        const mapHtml = fac.mapUrl ? `
                            <a href="${fac.mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn" onclick="event.stopPropagation()">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                                    <line x1="9" y1="3" x2="9" y2="18"></line>
                                    <line x1="15" y1="6" x2="15" y2="21"></line>
                                </svg>
                                Xem trên bản đồ
                            </a>
                        ` : '';

                        html += `
                            <div class="facility-card">
                                <div class="facility-img-wrap">
                                    ${imgHtml}
                                </div>
                                <div class="facility-body">
                                    <div class="facility-title-row">
                                        <h3>${name}</h3>
                                        ${verifiedHtml}
                                    </div>
                                    <p class="facility-address">
                                        <span>📍</span>
                                        <span>${address}</span>
                                    </p>
                                    <p class="facility-desc">${fac.description || ''}</p>
                                    ${mapHtml}
                                </div>
                            </div>
                        `;
                    });
                    html += `</div>`;
                    container.innerHTML = html;
                })
                .catch(err => {
                    console.error("Error loading facilities:", err);
                    container.innerHTML = `<div class="empty-state">Lỗi khi tải danh sách cơ sở y tế.</div>`;
                });
        });
    </script>
}
