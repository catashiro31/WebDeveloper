.badge-exp { color: #6366f1; }
.badge-fee { color: #16a34a; }
.fee-val { font-size: 13.5px; font-weight: 800; color: #15803d; }
.fee-unit { font-size: 11.5px; font-weight: 600; color: #16a34a; opacity: 0.85; margin-left: auto; }

.book-btn { 
  padding: 12px 0; 
  background: #eef2ff; 
  color: #4f46e5; 
  border: none; 
  border-radius: 14px; 
  font-size: 14px; 
  font-weight: 800; 
  cursor: pointer; 
  width: 100%; 
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
  font-family: var(--font-app);
  text-align: center;
}
.doc-card:hover .book-btn { 
  background: #6366f1; 
  color: #fff; 
  box-shadow: 0 8px 20px rgba(99,102,241,0.28); 
}

/* ===== TOP RATED PAGINATION & MOBILE COMPACT ===== */
.top-rated-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 28px;
}
.top-rated-pagination button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42px;
  height: 42px;
  padding: 0 16px;
  border-radius: 12px;
  border: 1.5px solid #e2e8f0;
  background: #fff;
  color: #475569;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: var(--font-app);
}
.top-rated-pagination button:hover:not(:disabled) {
  border-color: #6366f1;
  color: #6366f1;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(99,102,241,0.15);
}
.top-rated-pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}
.top-rated-pagination button.active {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  border-color: transparent;
  box-shadow: 0 8px 18px rgba(99,102,241,0.3);
}

@@media (max-width: 768px) {
  .carousel-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .carousel-item {
    width: 100%;
  }
  .carousel-item .doc-card {
    flex-direction: row;
    align-items: stretch;
    min-height: 135px;
    border-radius: 18px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
  }
  .carousel-item .avatar-wrap {
    width: 105px;
    min-width: 105px;
    max-width: 105px;
    height: auto;
    min-height: 135px;
    border-bottom: none;
    border-right: 1px solid #f1f5f9;
  }
  .carousel-item .initials-avatar {
    font-size: 30px;
  }
  .carousel-item .card-body {
    padding: 10px 12px;
    justify-content: space-between;
    gap: 4px;
    border-top: none;
  }
  .carousel-item .avail-badge span:last-child {
    font-size: 11.5px !important;
  }
  .carousel-item .card-doc-name {
    font-size: 15px;
    height: auto;
    line-height: 1.25;
    margin-bottom: 1px;
    white-space: normal;
  }
  .carousel-item .doc-spec {
    font-size: 12px;
    height: auto;
    line-height: 1.2;
    margin-top: 1px;
  }
  .carousel-item .doc-facility {
    font-size: 11px;
    height: auto;
    line-height: 15px;
    margin-top: 2px;
  }
  .carousel-item .card-bottom-wrap {
    padding-top: 6px;
    gap: 6px;
  }
  .carousel-item .card-meta-container {
    gap: 4px;
  }
  .carousel-item .meta-row-stats {
    gap: 6px;
  }
  .carousel-item .meta-pill {
    height: 25px;
    padding: 2px 7px;
    font-size: 11px;
    border-radius: 8px;
  }
  .carousel-item .meta-pill.fee {
    height: 25px;
    padding: 2px 7px;
    font-size: 11px;
    border-radius: 8px;
  }
  .carousel-item .fee-val {
    font-size: 11.5px;
  }
  .carousel-item .fee-unit {
    font-size: 10px;
  }
  .carousel-item .book-btn {
    padding: 6px 0;
    font-size: 12px;
    border-radius: 8px;
    font-weight: 700;
  }
}
</style>

<div class="appt-page">
    <nav class="breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/Portal/Doctors">Bác sĩ</a>
        <span class="breadcrumb-sep">/</span>
        <span>@Model.FullName</span>
    </nav>

    <div class="appt-container">
        <!-- HERO SECTION -->
        <section class="hero-card">
            <div class="img-wrap">
                @if (isPlaceholder)
                {
                    <div class="initials-fallback">@GetInitials(Model.FullName ?? "")</div>
                }
                else
                {
                    <div class="initials-fallback" style="display:none;">@GetInitials(Model.FullName ?? "")</div>
                    <img src="@photo" alt="@Model.FullName" class="doc-img" onerror="this.style.display='none'; this.previousElementSibling.style.display='flex';" />
                }
            </div>

            <div class="info-wrap">
                <div class="name-row">
                    <h1 class="doc-name">@Model.FullName</h1>
                    <div class="verified-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                        </svg>
                        Bác sĩ đã xác minh
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Degree))
                {
                    <div class="doc-degree">@Model.Degree</div>
                }
                <div class="doc-spec-pill">@Model.SpecialtyName</div>

                <div class="stat-pills">
                    <div class="stat-pill">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        @((Model.TotalReviews ?? reviews.Count) > 0 ? $"{Model.RatingAverage.GetValueOrDefault():0.0} ({Model.TotalReviews ?? reviews.Count} đánh giá)" : "Chưa có đánh giá")
                    </div>
                    <div class="stat-pill">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        @(Model.ExperienceYears ?? 0) năm kinh nghiệm
                    </div>
                    <div class="stat-pill">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        <span>@(Model.FacilityName ?? "Cơ sở y tế")</span>
                        @if (Model.FacilityVerified == true)
                        {
                            <span class="facility-verified-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                Đã xác minh
                            </span>
                        }
                    </div>
                </div>

                <div class="fee-wrap">
                    <div>
                        <p class="fee-label">Phí tư vấn</p>
                        <h2 class="fee-val">@Model.Price?.ToString("N0") đ</h2>
                    </div>
                </div>
            </div>
        </section>

        <!-- INFO GRID -->
        <section class="detail-grid">
            <!-- 1. Giới thiệu -->
            <div class="detail-card">
                <h2 class="section-title">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    Giới thiệu
                </h2>
                <p class="bio-text">@(Model.Bio ?? "Thông tin bác sĩ đang được cập nhật.")</p>
            </div>

            <!-- 2. Nơi làm việc -->
            <div class="detail-card">
                <h2 class="section-title">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                    Nơi làm việc
                </h2>
                <div class="contact-item">
                    <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></div>
                    <div class="contact-info">
                        <h4>Cơ sở</h4>
                        <div class="facility-name-row">
                            <p>@(Model.FacilityName ?? "Đang cập nhật")</p>
                            @if (Model.FacilityVerified == true)
                            {
                                <span class="facility-verified-badge">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                    Đã xác minh
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path></svg></div>
                    <div class="contact-info">
                        <h4>Địa chỉ</h4>
                        <p>
                            @if (!string.IsNullOrEmpty(Model.FacilityAddress) || !string.IsNullOrEmpty(Model.FacilityProvince))
                            {
                                @($"{Model.FacilityAddress}{(string.IsNullOrEmpty(Model.FacilityProvince) ? "" : ", " + Model.FacilityProvince)}")
                            }
                            else
                            {
                                @("Đang cập nhật")
                            }
                        </p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.FacilityMapUrl))
                {
                    <a href="@Model.FacilityMapUrl" target="_blank" rel="noopener noreferrer"
                       style="display: inline-flex; alignItems: center; gap: 8px; padding: 12px 20px; background: #f8fafc; color: #4f46e5; border-radius: 12px; font-size: 14px; font-weight: 600; text-decoration: none; transition: all 0.2s; margin-top: 8px; border: 1px solid #e2e8f0;"
                       onmouseover="this.style.background='#eef2ff'; this.style.borderColor='#c7d2fe';"
                       onmouseout="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0';">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                            <line x1="9" y1="3" x2="9" y2="18"></line>
                            <line x1="15" y1="6" x2="15" y2="21"></line>
                        </svg>
                        Xem vị trí trên bản đồ
                    </a>
                }
            </div>

            <!-- 3. Liên hệ -->
            <div class="detail-card">
                <h2 class="section-title">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    Liên hệ trực tiếp
                </h2>
                <div class="contact-item">
                    <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></div>
                    <div class="contact-info">
                        <h4>Email công việc</h4>
                        <p>@(string.IsNullOrEmpty(Model.DoctorEmail) ? "—" : Model.DoctorEmail)</p>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></div>
                    <div class="contact-info">
                        <h4>Hotline cá nhân</h4>
                        <p>@(string.IsNullOrEmpty(Model.DoctorPhone) ? "—" : Model.DoctorPhone)</p>
                    </div>
                </div>
            </div>

            <!-- 4. Đánh giá -->
            <div class="detail-card">
                <h2 class="section-title">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    Đánh giá từ người bệnh
                </h2>
                <div style="margin-bottom: 16px;">
                    <span style="font-size: 32px; font-weight: 800; color: #0f172a;">@(Model.RatingAverage?.ToString("0.0") ?? "5.0")</span>
                    <span style="color: #94a3b8; margin-left: 8px;">/ 5.0 (@(Model.TotalReviews ?? reviews.Count) nhận xét)</span>
                </div>

                @if (reviews.Any())
                {
                    foreach (var r in reviews)
                    {
                        <div class="review-snippet">
                            <div class="rev-header">
                                <span class="rev-author">@(r.PatientName ?? "Bệnh nhân ẩn danh")</span>
                                <div class="rev-stars">
                                    @for (int i = 0; i < (r.Rating ?? 5); i++)
                                    {
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                    }
                                </div>
                            </div>
                            <p style="margin: 0; color: #64748b; font-style: italic;">@(r.IsVisible ? $"\"{r.Comment}\"" : "Nội dung tiêu cực đã được ẩn")</p>
                        </div>
                    }
                }
                else
                {
                    <p style="color: #94a3b8;">Chưa có nhận xét chi tiết.</p>
                }
            </div>
        </section>

        <!-- BOOKING SECTION -->
        <div id="booking-section" class="booking-slots">
            <h3 class="booking-title">Lịch khám của bác sĩ</h3>

            <div class="week-tabs" id="bookingWeeks" role="group" aria-label="Chọn tuần khám"></div>

            <div id="dayGrid" class="day-grid"></div>

            <div class="slot-section-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Giờ khám khả dụng
            </div>

            <div id="slotGrid" class="slot-grid"></div>

            <div id="bookingForm" class="booking-form" style="display: none;">
                <div id="authPrompt" style="display: none;">
                    <p style="color: #6366f1; margin: 0; font-size: 14px; font-weight: 700; text-align: center;">
                        👉 Đăng nhập để đặt lịch khám cho bản thân
                    </p>
                </div>
                <div id="patientForm" style="display: none;">
                    <div style="margin-bottom: 20px;">
                        <label>Bệnh nhân</label>
                        <input type="hidden" id="patientSelect" />
                        <p id="patientName" role="status">Đang tải hồ sơ bản thân...</p>
                    </div>
                    <div>
                        <label>Lý do khám * <small style="font-weight: 500; color: #64748b;">(10 - 500 ký tự)</small></label>
                        <textarea id="reasonInput" placeholder="Nhập triệu chứng cụ thể của bạn (từ 10 đến 500 ký tự)..." minlength="10" maxlength="500"></textarea>
                    </div>
                </div>
            </div>

            <button id="bookBtn" class="book-appt-btn" disabled onclick="handleBook()">
                Xác nhận đặt lịch
            </button>
        </div>

        <!-- STICKY BOTTOM BOOKING BAR (mobile ≤640px) -->
        <div class="sticky-book-bar" id="stickyBookBar">
            <div class="sticky-book-info">
                <div class="sticky-book-label">Phí khám</div>
                <div class="sticky-book-fee" id="stickyFeeText">@(Model.Price?.ToString("N0") ?? "0")đ</div>
            </div>
            <button type="button" class="sticky-book-btn" onclick="handleBook()">
                🩺 Đặt lịch ngay
            </button>
        </div>

        <!-- Modal Xác nhận thông tin đặt lịch -->
        <div id="bookingConfirmModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(6px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
            <div class="booking-confirm-dialog" style="background: white; border-radius: 28px; width: 100%; max-width: 520px; padding: 32px; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25); box-sizing: border-box; max-height: 90vh; overflow-y: auto;">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 46px; height: 46px; border-radius: 14px; background: #eef2ff; color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">
                            🩺
                        </div>
                        <div>
                            <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: #0f172a;">Xác nhận đặt lịch khám</h3>
                            <p style="margin: 2px 0 0; font-size: 13px; color: #64748b;">Vui lòng kiểm tra lại thông tin chi tiết</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeConfirmModal()" style="background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; color: #64748b; font-size: 18px; display: flex; align-items: center; justify-content: center;">✕</button>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 18px; padding: 18px 20px; margin-bottom: 24px; font-size: 14px; display: flex; flex-direction: column; gap: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Bác sĩ phụ trách:</span>
                        <span style="font-weight: 700; color: #0f172a; text-align: right;">BS. @Model.FullName<br><small style="color: #6366f1; font-weight: 700;">Khoa: @Model.SpecialtyName</small></span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0;"></div>

                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Thời gian khám:</span>
                        <span id="confirmTimeSlot" style="font-weight: 700; color: #0f172a; text-align: right;">—</span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0;"></div>

                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Cơ sở y tế:</span>
                        <span style="font-weight: 700; color: #0f172a; text-align: right;">@(Model.FacilityName ?? "Chưa cập nhật")<br><small style="color: #64748b; font-weight: 500;">@(string.IsNullOrWhiteSpace(Model.FacilityAddress) ? "Chưa cập nhật" : Model.FacilityAddress)@(string.IsNullOrEmpty(Model.FacilityProvince) ? "" : $", {Model.FacilityProvince}")</small></span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0;"></div>

                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Người khám:</span>
                        <span id="confirmPatientName" style="font-weight: 700; color: #0f172a; text-align: right;">—</span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0;"></div>

                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Lý do khám:</span>
                        <span id="confirmReasonText" style="font-weight: 600; color: #334155; text-align: right; max-width: 250px; overflow-wrap: break-word;">—</span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0;"></div>

                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                        <span style="color: #64748b; font-size: 13px; flex-shrink: 0;">Phí tư vấn khám:</span>
                        <span style="font-size: 18px; font-weight: 800; color: #059669;">@(Model.Price?.ToString("N0") ?? "0") đ</span>
                    </div>
                </div>

                <div class="booking-confirm-actions" style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button type="button" onclick="closeConfirmModal()" style="padding: 12px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; font-weight: 700; font-size: 14px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.background='#f8fafc'" onmouseleave="this.style.background='white'">
                        Quay lại sửa
                    </button>
                    <button type="button" id="finalConfirmBtn" onclick="submitFinalBooking()" style="padding: 12px 24px; border-radius: 12px; border: none; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3); transition: all 0.2s;">
                        Xác nhận & Đặt khám
                    </button>
                </div>
            </div>
        </div>

        <!-- TOP RATED DOCTORS -->
        @if (topRated.Any())
        {
            <section style="margin-bottom: 60px;">
                <div class="section-row">
                    <div>
                        <h2 style="font-size: 24px; font-weight: 800; margin: 0; color: #0f172a;">Bác sĩ uy tín</h2>
                        <p style="margin: 4px 0 0; font-size: 14px; color: #64748b;">Các chuyên gia hàng đầu được bệnh nhân tin tưởng nhất</p>
                    </div>
                    <a href="/Portal/Doctors" style="color: #6366f1; font-weight: 700; text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 4px;">
                        Xem tất cả
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
                <div class="carousel-container" id="topRatedContainer">
                    @foreach (var d in topRated)
                    {
                        var dPhoto = !string.IsNullOrEmpty(d.AvatarUrl) ? d.AvatarUrl : "/images/placeholder.jpg";
                        var isDPhotoPlaceholder = string.IsNullOrEmpty(d.AvatarUrl) || d.AvatarUrl.Contains("placeholder") || d.AvatarUrl.Contains("dicebear") || d.AvatarUrl.Contains("ui-avatars");
                        
                        <div class="carousel-item">
                            <a href="/Portal/DoctorDetail?id=@d.DoctorId" class="doc-card">
                                <div class="avatar-wrap">
                                    @if (isDPhotoPlaceholder)
                                    {
                                        <div class="initials-avatar">@GetInitials(d.DoctorName ?? "")</div>
                                    }
                                    else
                                    {
                                        <div class="initials-avatar" style="display:none;">@GetInitials(d.DoctorName ?? "")</div>
                                        <img src="@dPhoto" alt="@d.DoctorName" class="avatar" onerror="this.style.display='none'; this.previousElementSibling.style.display='flex';" />
                                    }
                                </div>
                                <div class="card-body">
                                    <div class="avail-badge">
                                        <span class="dot" style="background: #22c55e"></span>
                                        <span style="color: #16a34a; font-size: 13px; font-weight: 700;">
                                            Đang hoạt động
                                        </span>
                                    </div>
                                    <h3 class="card-doc-name">@d.DoctorName</h3>
                                    <p class="doc-spec">@d.SpecialtyName</p>
                                    
                                    <div class="doc-facility">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7"/><path d="M4 21V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v17"/></svg>
                                        <span class="doc-facility-text">@(d.FacilityName ?? "Phòng khám riêng")@(string.IsNullOrEmpty(d.Province) ? "" : $" • {d.Province}")</span>
                                    </div>

                                    <div class="card-bottom-wrap">
                                        <div class="card-meta-container">
                                            <div class="meta-row-stats">
                                                <span class="meta-pill rating" title="Đánh giá">
                                                    <svg class="badge-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                                                    <span>@(d.RatingAverage.HasValue && d.RatingAverage > 0 ? d.RatingAverage.Value.ToString("0.0") : "5.0")</span>
                                                </span>
                                                <span class="meta-pill exp" title="Kinh nghiệm">
                                                    <svg class="badge-exp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                                    <span>@(d.Experience ?? 0) năm</span>
                                                </span>
                                            </div>
                                            <div class="meta-pill fee" title="Giá khám">
                                                <svg class="badge-fee" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                                                <span class="fee-val">@((d.Price ?? 0).ToString("N0"))đ</span>
                                                <span class="fee-unit">/ lượt khám</span>
                                            </div>
                                        </div>
                                        <button type="button" class="book-btn">Đặt lịch hẹn</button>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <!-- Pagination for Top Rated -->
                <div class="top-rated-pagination" id="topRatedPagination"></div>
            </section>
        }
    </div>

    <button class="floating-cta" onclick="document.getElementById('booking-section').scrollIntoView({ behavior: 'smooth', block: 'start' });">
        Đặt lịch ngay 
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
</div>

@section Scripts {
    <script>
        const docId = @Model.Id;
        const DAYS = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        
        // Build date-only values from Vietnam time; browser timezone cannot shift a booking day.
        const vietnamDate = new Intl.DateTimeFormat('en-CA', {timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit'}).format(new Date());
        const firstDay = new Date(vietnamDate + 'T00:00:00Z');
        const allDays = Array.from({length: @WebDeveloper.Helpers.BookingWindow.MaxAdvanceDays + 1}, (_, i) => {
            const date = new Date(firstDay); date.setUTCDate(date.getUTCDate() + i); return date;
        });
        const weeks = document.getElementById('bookingWeeks');
        for (let i = 0; i < Math.ceil(allDays.length / 7); i++) {
            const button = document.createElement('button'); button.type = 'button';
            button.id = 'week' + i + 'Btn'; button.className = 'week-tab-btn' + (i === 0 ? ' week-tab-btn--active' : '');
            button.textContent = i === 0 ? 'Tuần đầu' : 'Tuần ' + (i + 1);
            button.setAttribute('aria-pressed', String(i === 0)); button.onclick = () => setWeek(i); weeks.append(button);
        }

        let week = 0;
        let selectedDayIdx = 0;
        let slots = [];
        let selectedSlot = null;
        let isAuth = false;
        let userRole = null;

        const dayGrid = document.getElementById('dayGrid');
        const slotGrid = document.getElementById('slotGrid');
        const bookBtn = document.getElementById('bookBtn');
        const bookingForm = document.getElementById('bookingForm');
        const authPrompt = document.getElementById('authPrompt');
        const patientForm = document.getElementById('patientForm');
        const patientSelect = document.getElementById('patientSelect');
        const reasonInput = document.getElementById('reasonInput');

        // Check auth status
        const token = localStorage.getItem('token');
        const userStr = localStorage.getItem('user');
        if (token && userStr) {
            try {
                const user = JSON.parse(userStr);
                isAuth = true;
                userRole = user.role;
            } catch(e){}
        }

        function renderDays() {
            dayGrid.innerHTML = '';
            const startIdx = week * 7;
            for(let i = 0; i < 7 && startIdx + i < allDays.length; i++) {
                const absIdx = startIdx + i;
                const d = allDays[absIdx];
                const btn = document.createElement('button');
                btn.className = 'day-btn ' + (selectedDayIdx === absIdx ? 'day-btn--active' : '');
                btn.onclick = () => { selectedDayIdx = absIdx; renderDays(); fetchSlots(); };
                btn.innerHTML = `<span class="day-name">${DAYS[d.getUTCDay()]}</span><span class="day-num">${d.getUTCDate()}/${d.getUTCMonth()+1}</span>`;
                dayGrid.appendChild(btn);
            }
        }

        window.setWeek = (w) => {
            if (!Number.isInteger(w) || w < 0 || w * 7 >= allDays.length) return;
            week = w;
            selectedDayIdx = w * 7;
            weeks.querySelectorAll('button').forEach((button, i) => {
                button.classList.toggle('week-tab-btn--active', i === w);
                button.setAttribute('aria-pressed', String(i === w));
            });
            renderDays();
            fetchSlots();
        };

        function formatDate(d) {
            return d.toISOString().slice(0, 10);
        }

        function formatTimeSlot(time) {
            if(!time) return '';
            return time.replace('SLOT_', '').replace('_', ':').substring(0, 5);
        }

        let slotRequest = 0;
        async function fetchSlots() {
            const request = ++slotRequest;
            slotGrid.innerHTML = '<span class="slot-empty">Đang tìm các khung giờ trống...</span>';
            selectedSlot = null;
            updateBookingForm();
            
            try {
                const dateStr = formatDate(allDays[selectedDayIdx]);
                const res = await fetch(`/api/v1/portal/doctors/${docId}/slots?date=${dateStr}`);
                if (!res.ok) throw new Error(await readApiMessage(res));
                const data = await res.json();
                if (request !== slotRequest) return;
                const now = new Date(new Date().toLocaleString('en-US', {timeZone: 'Asia/Ho_Chi_Minh'}));
                const isSelectedDateToday = dateStr === vietnamDate;
                const nowHour = now.getHours();
                const nowMin = now.getMinutes();

                slots = (Array.isArray(data) ? data : []).filter(s => {
                    if (s.status !== 'AVAILABLE' && s.isBooked) return false;
                    if (isSelectedDateToday) {
                        const tStr = formatTimeSlot(s.timeSlot || s.startTime || s.time);
                        if (tStr) {
                            const [sh, sm] = tStr.split(':').map(Number);
                            if (sh < nowHour || (sh === nowHour && sm <= nowMin)) return false;
                        }
                    }
                    return true;
                });
                
                if (slots.length === 0) {
                    slotGrid.innerHTML = '<span class="slot-empty">Hiện không có khung giờ nào khả dụng.</span>';
                } else {
                    slotGrid.innerHTML = '';
                    slots.forEach(slot => {
                        const btn = document.createElement('button');
                        const isBooked = slot.isBooked || slot.status === 'BOOKED';
                        btn.className = 'slot-btn ' + (isBooked ? 'slot-btn--booked' : '');
                        btn.disabled = isBooked;
                        btn.innerText = formatTimeSlot(slot.timeSlot || slot.startTime || slot.time);
                        btn.onclick = () => { 
                            if(!isBooked) {
                                selectedSlot = slot; 
                                renderSlots(); 
                                updateBookingForm(); 
                            }
                        };
                        slotGrid.appendChild(btn);
                    });
                }
            } catch(e) {
                if (request !== slotRequest) return;
                console.error(e);
                slotGrid.innerHTML = '<span class="slot-empty">Lỗi khi tải lịch.</span>';
            }
        }

        function renderSlots() {
            Array.from(slotGrid.children).forEach((btn, i) => {
                const slot = slots[i];
                if (slot) {
                    const isBooked = slot.isBooked || slot.status === 'BOOKED';
                    btn.className = 'slot-btn ' + (selectedSlot === slot ? 'slot-btn--active' : '') + (isBooked ? ' slot-btn--booked' : '');
                }
            });
        }

        async function fetchRelatives() {
            if (isAuth && userRole === 'PATIENT') {
                try {
                    const res = await fetch('/api/v1/patient/relatives', {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (!res.ok) throw new Error(await readApiMessage(res));
                    const rels = await res.json();
                    const self = rels.find(r => r.relationship === 'SELF');
                    if (!self) throw new Error('Không tìm thấy hồ sơ bản thân. Vui lòng cập nhật hồ sơ hoặc liên hệ hỗ trợ.');
                    patientSelect.value = self.patientId || self.id;
                    document.getElementById('patientName').textContent = `${self.fullName} (Bản thân)`;
                } catch(e) {
                    patientSelect.value = '';
                    document.getElementById('patientName').textContent = 'Không thể tải hồ sơ bản thân. Vui lòng tải lại trang.';
                    showApiToast(e.message, 'error');
                }
                updateBookingForm();
            }
        }

        function updateBookingForm() {
            const stickyBar = document.getElementById('stickyBookBar');
            if (!selectedSlot) {
                bookingForm.style.display = 'none';
                bookBtn.disabled = true;
                bookBtn.innerText = 'Xác nhận đặt lịch';
                if (stickyBar) stickyBar.classList.remove('visible');
                return;
            }
            
            bookingForm.style.display = 'block';
            if (stickyBar) stickyBar.classList.add('visible');
            if (!isAuth) {
                authPrompt.style.display = 'block';
                patientForm.style.display = 'none';
                bookBtn.disabled = false;
                bookBtn.innerText = 'Tiếp tục đăng nhập';
            } else {
                authPrompt.style.display = 'none';
                patientForm.style.display = 'block';
                bookBtn.disabled = !patientSelect.value;
                bookBtn.innerText = 'Xác nhận đặt lịch';
            }
        }

        window.closeConfirmModal = () => {
            document.getElementById('bookingConfirmModal').style.display = 'none';
        };

        window.handleBook = () => {
            if (!selectedSlot) return;

            if (!isAuth) {
                window.location.href = `/Auth/Login?returnUrl=/Portal/DoctorDetail?id=${docId}`;
                return;
            }

            if (!patientSelect.value) {
                showApiToast('Chưa tải được hồ sơ bản thân. Vui lòng tải lại trang.', 'error');
                return;
            }
            const reason = reasonInput.value.trim();
            if (window.Validation) {
                const reasonCheck = window.Validation.validateReason(reason);
                if (!reasonCheck.valid) {
                    showApiToast(reasonCheck.message, "error");
                    reasonInput.focus();
                    return;
                }
            } else if (!reason || reason.length < 10 || reason.length > 500) {
                showApiToast("Lý do khám phải từ 10 đến 500 ký tự.", "error");
                reasonInput.focus();
                return;
            }

            // Fill summary modal
            const dateStr = formatDate(allDays[selectedDayIdx]);
            const timeStr = formatTimeSlot(selectedSlot.timeSlot || selectedSlot.startTime || selectedSlot.time);
            document.getElementById('confirmTimeSlot').textContent = `${timeStr} - ${dateStr}`;

            document.getElementById('confirmPatientName').textContent = document.getElementById('patientName').textContent;
            document.getElementById('confirmReasonText').textContent = reason;

            const modal = document.getElementById('bookingConfirmModal');
            modal.style.display = 'flex';
        };

        window.submitFinalBooking = async () => {
            if (!selectedSlot) return;
            if (!patientSelect.value) {
                showApiToast('Chưa tải được hồ sơ bản thân. Vui lòng tải lại trang.', 'error');
                return;
            }
            const reason = reasonInput.value.trim();
            if (window.Validation) {
                const reasonCheck = window.Validation.validateReason(reason);
                if (!reasonCheck.valid) {
                    showApiToast(reasonCheck.message, "error");
                    return;
                }
            } else if (!reason) {
                return;
            }

            const finalBtn = document.getElementById('finalConfirmBtn');
            finalBtn.disabled = true;
            finalBtn.innerText = 'Đang xử lý...';

            try {
                const req = {
                    scheduleId: selectedSlot.scheduleId || selectedSlot.id,
                    patientId: Number(patientSelect.value),
                    reason: reason
                };

                const res = await fetch('/api/v1/patient/appointments', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(req)
                });

                if (res.ok) {
                    showApiToast("Đặt lịch thành công! Đang chuyển hướng...", "success");
                    setTimeout(() => window.location.href = '/Patient/Appointments', 1200);
                } else {
                    const msg = await readApiMessage(res);
                    showApiToast(msg || "Đặt lịch thất bại", "error");
                    finalBtn.disabled = false;
                    finalBtn.innerText = 'Xác nhận & Đặt khám';
                }
            } catch(e) {
                showApiToast("Có lỗi xảy ra", "error");
                finalBtn.disabled = false;
                finalBtn.innerText = 'Xác nhận & Đặt khám';
            }
        };

        // Init
        renderDays();
        fetchSlots();
        if (isAuth && userRole === 'PATIENT') {
            fetchRelatives();
        }

        // ===== TOP RATED PAGINATION =====
        function initTopRatedPagination() {
            const container = document.getElementById('topRatedContainer');
            const pagination = document.getElementById('topRatedPagination');
            if (!container || !pagination) return;

            const items = Array.from(container.querySelectorAll('.carousel-item'));
            if (items.length === 0) return;

            function getPageSize() {
                return window.innerWidth <= 768 ? 2 : 3;
            }

            let currentTopRatedPage = 0;

            function renderTopRatedPage(page) {
                const pageSize = getPageSize();
                const totalPages = Math.ceil(items.length / pageSize);
                if (totalPages <= 1) {
                    pagination.style.display = 'none';
                    items.forEach(it => it.style.display = 'flex');
                    return;
                }

                pagination.style.display = 'flex';
                if (page < 0) page = 0;
                if (page >= totalPages) page = totalPages - 1;
                currentTopRatedPage = page;

                const start = page * pageSize;
                const end = start + pageSize;

                items.forEach((item, idx) => {
                    if (idx >= start && idx < end) {
                        item.style.display = 'flex';
                    } else {
                        item.style.display = 'none';
                    }
                });

                let html = `<button type="button" ${page === 0 ? 'disabled' : ''} onclick="changeTopRatedPage(${page - 1})">←</button>`;
                for (let i = 0; i < totalPages; i++) {
                    html += `<button type="button" class="${page === i ? 'active' : ''}" onclick="changeTopRatedPage(${i})">${i + 1}</button>`;
                }
                html += `<button type="button" ${page === totalPages - 1 ? 'disabled' : ''} onclick="changeTopRatedPage(${page + 1})">→</button>`;
                pagination.innerHTML = html;
            }

            window.changeTopRatedPage = function(p) {
                renderTopRatedPage(p);
            };

            renderTopRatedPage(0);
            window.addEventListener('resize', () => renderTopRatedPage(currentTopRatedPage));
        }

        initTopRatedPagination();
    </script>
}
