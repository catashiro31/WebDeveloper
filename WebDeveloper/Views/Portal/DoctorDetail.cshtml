  height: 100%; 
  width: 100%; 
  object-fit: cover; 
  object-position: top; 
  transition: transform 0.5s ease; 
}
.doc-card:hover .avatar { transform: scale(1.06); }
.initials-avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
