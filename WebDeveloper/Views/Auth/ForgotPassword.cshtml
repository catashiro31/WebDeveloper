@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - DocBooking</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { margin: 0; font-family: 'Inter', sans-serif; background: #f3f3f3; }
        .forgot-container { display: flex; height: 100vh; }
        .form-panel { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0 40px; }
        .form-content { width: 100%; max-width: 400px; text-align: left; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: #6b7280; text-decoration: none; font-size: 14px; margin-bottom: 28px; transition: color 0.2s; }
        .back-link:hover { color: #5f6dfc; }
        .title { font-size: 32px; margin-bottom: 10px; color: #333; font-weight: bold; }
        .subtitle { color: #777; font-size: 14px; margin-bottom: 25px; }
        .alert-error { background: #fee2e2; color: #dc2626; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: none; }
        .alert-success { background: #dcfce7; color: #16a34a; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: none; }
        .alert-success a { color: #16a34a; font-weight: bold; text-decoration: none; margin-top: 10px; display: inline-block; }
        .form-input { width: 100%; padding: 10px 0; margin-bottom: 20px; border: none; border-bottom: 1px solid #ccc; background: transparent; outline: none; box-sizing: border-box; transition: border-color 0.2s; }
        .form-input:focus { border-bottom: 2px solid #5f6dfc; }
        .btn-submit { margin-top: 20px; padding: 12px 30px; border-radius: 30px; border: none; background: #8ec5e8; color: white; cursor: pointer; width: 100%; font-size: 15px; font-weight: 600; transition: background 0.2s; }
        .btn-submit:hover:not(:disabled) { background: #7ab2d6; }
        .btn-submit:disabled { background: #ccc; cursor: not-allowed; }
        .image-panel { flex: 1; position: relative; clip-path: ellipse(85% 100% at 100% 50%); }
        .image-panel img { width: 100%; height: 100%; object-fit: cover; }
    </style>
</head>
<body>
    <div class="forgot-container">
        <div class="form-panel">
            <form id="forgotForm" class="form-content" onsubmit="handleSubmit(event)">
                <a href="/Auth/Login" class="back-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                    Quay lại đăng nhập
                </a>

                <h2 class="title">Quên mật khẩu</h2>
                <p class="subtitle">Nhập email của bạn để nhận mật khẩu mới</p>

                <div id="errorAlert" class="alert-error"></div>
                <div id="successAlert" class="alert-success">
                    <span id="successText"></span>
                    <div><a href="/Auth/Login">Đăng nhập ngay</a></div>
                </div>

                <input type="email" id="emailInput" class="form-input" placeholder="Email" required />

                <button type="submit" id="submitBtn" class="btn-submit">Gửi mật khẩu mới</button>
            </form>
        </div>

        <div class="image-panel">
            <img src="/images/bg.png" alt="forgot-password" />
        </div>
    </div>

    <script>
        function handleSubmit(e) {
            e.preventDefault();
            const email = document.getElementById('emailInput').value.trim();
            const errorAlert = document.getElementById('errorAlert');
            const successAlert = document.getElementById('successAlert');
            const btn = document.getElementById('submitBtn');

            errorAlert.style.display = 'none';
            successAlert.style.display = 'none';

            if (!email) {
                errorAlert.innerText = "Vui lòng nhập email";
                errorAlert.style.display = 'block';
                return;
            }

            btn.disabled = true;
            btn.innerText = 'Đang gửi...';

            fetch(`/api/v1/auth/forgot-password?email=${encodeURIComponent(email)}`, {
                method: 'POST'
            })
            .then(async res => {
                if (res.ok) {
                    const txt = await res.text();
                    document.getElementById('successText').innerText = txt || "Mật khẩu mới đã được gửi đến email của bạn!";
                    successAlert.style.display = 'block';
                } else {
                    const txt = await res.text();
                    errorAlert.innerText = txt || "Có lỗi xảy ra. Vui lòng thử lại.";
                    errorAlert.style.display = 'block';
                }
            })
            .catch(() => {
                errorAlert.innerText = "Có lỗi xảy ra. Vui lòng kiểm tra kết nối mạng.";
                errorAlert.style.display = 'block';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerText = 'Gửi mật khẩu mới';
            });
        }
    </script>
</body>
</html>
